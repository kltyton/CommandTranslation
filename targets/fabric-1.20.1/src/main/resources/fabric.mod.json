{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "client",
  "mixins": [
    "command_translation.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "${mod_java_package}.CommandTranslationFabric"
    ],
    "modmenu": [
      "${mod_java_package}.client.integration.fabric.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": "${loader_version_range}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}",
    "nbtac": ">=${nbtac_version} <2.2",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
