{
  "en_us": {
    "command_translation.help.argument.fillbiome.from": "One corner block position of the region whose biome is changed; biomes are stored in 4x4x4 cells, so the resulting edge is not perfectly straight.",
    "command_translation.help.argument.fillbiome.to": "The opposite corner block position, completing the region to fill.",
    "command_translation.help.argument.fillbiome.biome": "The biome to fill the area with; a biome tag is not accepted here.",
    "command_translation.help.argument.fillbiome.replace": "Restricts the change to biomes matching the filter.",
    "command_translation.help.argument.fillbiome.filter": "A biome or a #-prefixed biome tag selecting which existing biomes may be replaced."
  },
  "zh_cn": {
    "command_translation.help.argument.fillbiome.from": "要更改生物群系区域的一个角坐标，与 to 一起构成范围；群系按 4×4×4 单元存储，边界并不笔直。",
    "command_translation.help.argument.fillbiome.to": "与之相对的另一个角坐标。",
