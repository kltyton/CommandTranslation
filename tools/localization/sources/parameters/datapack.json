  "de_de": {
    "command_translation.help.argument.datapack.disable": "Deaktiviert ein bereits aktiviertes Datenpaket; ein beim Erstellen der Welt aktiviertes eingebautes Paket lässt sich so nicht deaktivieren.",
    "command_translation.help.argument.datapack.enable": "Aktiviert ein Datenpaket, optional mit Angabe seiner Position in der Ladereihenfolge.",
    "command_translation.help.argument.datapack.list": "Listet Datenpakete; ohne Option werden alle aufgelistet.",
    "command_translation.help.argument.datapack.create": "Erstellt ein neues leeres Verzeichnis-Datenpaket für die aktuelle Welt.",
    "command_translation.help.argument.datapack.name": "Der Name des Datenpakets, passend zu seinem Ordner- oder ZIP-Namen.",
    "command_translation.help.argument.datapack.existing": "Der Name eines bereits aktivierten Datenpakets, das als Anker für die Reihenfolge dient.",
    "command_translation.help.argument.datapack.after": "Lädt dieses Paket direkt nach dem angegebenen Paket, also mit höherer Priorität.",
    "command_translation.help.argument.datapack.before": "Lädt dieses Paket direkt vor dem angegebenen Paket, also mit niedrigerer Priorität.",
    "command_translation.help.argument.datapack.first": "Lädt dieses Paket vor allen anderen (niedrigste Priorität).",
    "command_translation.help.argument.datapack.last": "Lädt dieses Paket nach allen anderen (höchste Priorität).",
    "command_translation.help.argument.datapack.available": "Listet nur die vorhandenen, aber derzeit nicht aktivierten Datenpakete.",
    "command_translation.help.argument.datapack.enabled": "Listet nur die aktuell aktivierten Datenpakete in Ladereihenfolge.",
    "command_translation.help.argument.datapack.id": "Name des neuen Paketordners.",
    "command_translation.help.argument.datapack.description": "Die Beschreibung, die in die pack.mcmeta des neuen Pakets geschrieben wird."
  },
  "ja_jp": {
    "command_translation.help.argument.datapack.disable": "すでに有効なデータパックを無効化する。ワールド作成時に有効だった組み込みパックはこの方法では無効にできない。",
    "command_translation.help.argument.datapack.enable": "データパックを有効化し、必要なら読み込み順での位置を指定する。",
    "command_translation.help.argument.datapack.list": "データパックを一覧表示する。オプションなしではすべてを表示する。",
    "command_translation.help.argument.datapack.create": "現在のワールド用に新しい空のディレクトリデータパックを作成する。",
    "command_translation.help.argument.datapack.name": "データパックの名前。フォルダ名または zip 名と一致させる。",
    "command_translation.help.argument.datapack.existing": "順序の基準として使う、すでに有効なデータパックの名前。",
    "command_translation.help.argument.datapack.after": "このパックを指定したパックの直後に読み込む（優先度はより高い）。",
    "command_translation.help.argument.datapack.before": "このパックを指定したパックの直前に読み込む（優先度はより低い）。",
    "command_translation.help.argument.datapack.first": "このパックを他のすべてより前に読み込む（優先度は最低）。",
    "command_translation.help.argument.datapack.last": "このパックを他のすべてより後に読み込む（優先度は最高）。",
    "command_translation.help.argument.datapack.available": "存在するが現在は未有効のデータパックだけを一覧表示する。",
    "command_translation.help.argument.datapack.enabled": "現在有効なデータパックだけを読み込み順に一覧表示する。",
    "command_translation.help.argument.datapack.id": "新しいパックフォルダの名前。",
    "command_translation.help.argument.datapack.description": "新しいパックの pack.mcmeta に書き込む説明。"
  },
