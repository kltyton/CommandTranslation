{
  "en_us": {
    "command_translation.help.argument.datapack.disable": "Disables an already enabled data pack; a built-in pack enabled when the world was created cannot be disabled this way.",
    "command_translation.help.argument.datapack.enable": "Enables a data pack, optionally choosing where it sits in the load order.",
    "command_translation.help.argument.datapack.list": "Lists data packs; with no option all packs are listed.",
    "command_translation.help.argument.datapack.create": "Creates a new empty directory data pack for the current world.",
    "command_translation.help.argument.datapack.name": "The name of the data pack, matching its folder or zip name.",
    "command_translation.help.argument.datapack.existing": "The name of an already enabled data pack, used as the anchor for ordering.",
    "command_translation.help.argument.datapack.after": "Loads this pack just after the given pack, i.e. at higher priority.",
    "command_translation.help.argument.datapack.before": "Loads this pack just before the given pack, i.e. at lower priority.",
    "command_translation.help.argument.datapack.first": "Loads this pack before all others (lowest priority).",
    "command_translation.help.argument.datapack.last": "Loads this pack after all others (highest priority).",
    "command_translation.help.argument.datapack.available": "Lists only the data packs that are present but not currently enabled.",
    "command_translation.help.argument.datapack.enabled": "Lists only the currently enabled data packs, in load order.",
    "command_translation.help.argument.datapack.id": "Name of the new pack directory.",
    "command_translation.help.argument.datapack.description": "The description written into the new pack's pack.mcmeta."
  },
  "zh_cn": {
    "command_translation.help.argument.datapack.disable": "禁用已启用的数据包；创建世界时启用的内置数据包无法这样禁用。",
    "command_translation.help.argument.datapack.enable": "启用一个数据包，并可指定它在加载顺序中的位置。",
    "command_translation.help.argument.datapack.list": "列出数据包；不带选项时列出全部。",
    "command_translation.help.argument.datapack.create": "为当前世界新建一个空目录数据包。",
    "command_translation.help.argument.datapack.name": "数据包的名称，需与其文件夹或 zip 名一致。",
    "command_translation.help.argument.datapack.existing": "已启用的数据包名称，用作排序的参照锚点。",
    "command_translation.help.argument.datapack.after": "把该数据包紧插在指定数据包之后，即优先级更高。",
    "command_translation.help.argument.datapack.before": "把该数据包紧插在指定数据包之前，即优先级更低。",
    "command_translation.help.argument.datapack.first": "让该数据包最先加载（优先级最低）。",
    "command_translation.help.argument.datapack.last": "让该数据包最后加载（优先级最高）。",
    "command_translation.help.argument.datapack.available": "只列出已存在但当前未启用的数据包。",
    "command_translation.help.argument.datapack.enabled": "只按加载顺序列出当前已启用的数据包。",
    "command_translation.help.argument.datapack.id": "新数据包目录的名称。",
    "command_translation.help.argument.datapack.description": "写入新数据包 pack.mcmeta 的描述。"
  },
