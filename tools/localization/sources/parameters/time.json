    "command_translation.help.argument.time.value.midnight": "Setzt die Zeit auf die Mitte der Nacht.",
    "command_translation.help.argument.time.value.night": "Setzt die Zeit auf den Beginn der Nacht.",
    "command_translation.help.argument.time.value.noon": "Setzt die Zeit auf den Mittag.",
    "command_translation.help.argument.time.pause": "Pausiert die Standard-Weltuhr der aktuellen Dimension, ohne Wesen oder das Spiel einzufrieren.",
    "command_translation.help.argument.time.resume": "Setzt die ausgewählte Weltuhr nach dem Pausieren fort.",
    "command_translation.help.argument.time.rate": "Legt fest, wie schnell die ausgewählte Weltuhr fortschreitet, nicht die Tickrate des Servers.",
    "command_translation.help.argument.time.rate.rate": "Der Geschwindigkeitsmultiplikator der Uhr; 1 ist normale Geschwindigkeit.",
    "command_translation.help.argument.time.of": "Wirkt auf eine benannte Weltuhr statt auf die Standarduhr.",
    "command_translation.help.argument.time.clock": "Die ID der Weltuhr; ohne time of gilt die Standarduhr der Ausführungsdimension.",
    "command_translation.help.argument.time.of.add": "Addiert Zeit zur gewählten Uhr.",
    "command_translation.help.argument.time.of.pause": "Pausiert die gewählte Uhr.",
    "command_translation.help.argument.time.of.query": "Fragt Zeit oder Zeitlinie der gewählten Uhr ab.",
