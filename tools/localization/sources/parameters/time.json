{
  "en_us": {
    "command_translation.help.argument.time.add": "Adds an amount to the day/night clock, not to the world's total running time.",
    "command_translation.help.argument.time.set": "Sets the day/night clock to a number of ticks or a named time marker, replacing its previous time.",
    "command_translation.help.argument.time.query": "Prints the world's current time.",
    "command_translation.help.argument.time.query.time": "Reports the current time of the clock being queried.",
    "command_translation.help.argument.time.time": "The time to set or add, as a unit-carrying value or a bare number for ticks.",
    "command_translation.help.argument.time.value.day": "Sets the day/night clock to the daytime preset and resets its elapsed day count.",
    "command_translation.help.argument.time.value.daytime": "The number of ticks since the last sunrise.",
    "command_translation.help.argument.time.value.gametime": "Reports the total number of game ticks the world has run.",
    "command_translation.help.argument.time.value.midnight": "Sets the time to the middle of the night.",
    "command_translation.help.argument.time.value.night": "Sets the time to the start of the night.",
    "command_translation.help.argument.time.value.noon": "Sets the time to midday.",
    "command_translation.help.argument.time.pause": "Pauses the default world clock of the current dimension without freezing entities or the game.",
    "command_translation.help.argument.time.resume": "Resumes the selected world clock after pausing it.",
    "command_translation.help.argument.time.rate": "Sets how quickly the selected world clock advances, not the server's tick rate.",
    "command_translation.help.argument.time.rate.rate": "The clock's rate multiplier; 1 is normal speed.",
    "command_translation.help.argument.time.of": "Operates on a named world clock instead of the default one.",
    "command_translation.help.argument.time.clock": "The world clock id; without time of, the default clock of the execution dimension is used.",
    "command_translation.help.argument.time.of.add": "Adds time to the chosen clock.",
    "command_translation.help.argument.time.of.pause": "Pauses the chosen clock.",
    "command_translation.help.argument.time.of.query": "Queries the chosen clock's time or timeline.",
    "command_translation.help.argument.time.of.resume": "Resumes the chosen clock.",
    "command_translation.help.argument.time.of.set": "Sets the chosen clock's time.",
    "command_translation.help.argument.time.timemarker": "A named moment on the selected clock's timeline; sets the clock to that moment.",
    "command_translation.help.argument.time.timeline": "A timeline id belonging to the selected clock; querying reports ticks elapsed in the current repetition.",
    "command_translation.help.argument.time.repetition": "Reports how many full periods of the selected timeline have elapsed.",
    "command_translation.help.argument.time.query.day": "Reports elapsed in-game days in the day/night clock."
  },
  "zh_cn": {
    "command_translation.help.argument.time.add": "为昼夜时钟增加时间，不增加世界累计运行时间。",
    "command_translation.help.argument.time.set": "把昼夜时钟设为刻数或命名时刻，覆盖原时间。",
    "command_translation.help.argument.time.query": "输出世界当前的时间。",
    "command_translation.help.argument.time.query.time": "输出所查询时钟的当前时间。",
    "command_translation.help.argument.time.time": "要设置或增加的时间，写成带单位的值，或只写数字表示刻。",
    "command_translation.help.argument.time.value.day": "把昼夜时钟设为白天预设，并重置累计天数。",
    "command_translation.help.argument.time.value.daytime": "自上次日出以来的刻数。",
    "command_translation.help.argument.time.value.gametime": "查询世界累计运行的游戏刻数。",
    "command_translation.help.argument.time.value.midnight": "把时间设为半夜。",
    "command_translation.help.argument.time.value.night": "把时间设为夜晚开始。",
    "command_translation.help.argument.time.value.noon": "把时间设为正午。",
    "command_translation.help.argument.time.pause": "暂停当前维度的默认世界时钟，不冻结实体或整个游戏。",
    "command_translation.help.argument.time.resume": "恢复所选世界时钟的推进。",
    "command_translation.help.argument.time.rate": "设置所选世界时钟的推进倍率，而非服务器刻速率。",
    "command_translation.help.argument.time.rate.rate": "时钟速率倍率，1 为正常速度。",
    "command_translation.help.argument.time.of": "操作指定的世界时钟，而非默认时钟。",
    "command_translation.help.argument.time.clock": "世界时钟 id；不写 time of 时使用执行维度的默认时钟。",
    "command_translation.help.argument.time.of.add": "为所选时钟增加时间。",
    "command_translation.help.argument.time.of.pause": "暂停所选时钟。",
    "command_translation.help.argument.time.of.query": "查询所选时钟的时间或时间线。",
    "command_translation.help.argument.time.of.resume": "恢复所选时钟。",
    "command_translation.help.argument.time.of.set": "设置所选时钟的时间。",
    "command_translation.help.argument.time.timemarker": "所选时钟时间线上的命名时刻，把时钟设到该时刻。",
    "command_translation.help.argument.time.timeline": "属于所选时钟的时间线 id；查询时报告当前周期内经过的刻数。",
    "command_translation.help.argument.time.repetition": "查询所选时间线经过的完整周期数。",
    "command_translation.help.argument.time.query.day": "查询昼夜时钟经过的游戏天数。"
  },
