    "command_translation.help.argument.time.of.set": "Setzt die Zeit der gewählten Uhr.",
    "command_translation.help.argument.time.timemarker": "Ein benannter Zeitpunkt auf der Zeitlinie der gewählten Uhr; setzt die Uhr auf diesen Zeitpunkt.",
    "command_translation.help.argument.time.timeline": "Eine Zeitlinien-ID der gewählten Uhr; eine Abfrage meldet die Ticks der aktuellen Wiederholung.",
    "command_translation.help.argument.time.repetition": "Meldet, wie viele vollständige Perioden der gewählten Zeitlinie vergangen sind.",
    "command_translation.help.argument.time.query.day": "Meldet die vergangenen In-Game-Tage der Tag-/Nacht-Uhr."
  },
