{
  "en_us": {
    "command_translation.help.argument.item.modify": "Applies an item modifier (loot modifier) to the items in one inventory slot; it changes the item id only if the modifier does.",
    "command_translation.help.argument.item.modify.block": "Target is a container block (chest, furnace, ...) at a block position.",
    "command_translation.help.argument.item.pos": "Block position of the target container block, as x y z.",
    "command_translation.help.argument.item.slot": "The single slot to change, written slot_type or slot_type.number; valid slot types depend on whether the target is a block or an entity.",
    "command_translation.help.argument.item.modifier": "The item modifier to apply: a resource location of a registered item_modifier or an inline SNBT definition; fails if it is not valid.",
    "command_translation.help.argument.item.modify.entity": "Target is one or more entities' inventories (players or mobs).",
    "command_translation.help.argument.item.targets": "One or more entities to modify: a player name, target selector, or UUID.",
    "command_translation.help.argument.item.replace": "Overwrites the items in a slot with a new item, or copies them from another slot.",
    "command_translation.help.argument.item.replace.block": "Replaces into a container block at the given position.",
    "command_translation.help.argument.item.replace.block.pos.slot.from": "Option from: copies the item from a source slot instead of naming a new item with with.",
    "command_translation.help.argument.item.replace.block.pos.slot.from.block": "Source is a container block; its item is copied from the chosen slot.",
    "command_translation.help.argument.item.sourcePos": "Block position of the source container block to copy from, as x y z.",
    "command_translation.help.argument.item.sourceSlot": "The single source slot to copy from, written slot_type or slot_type.number.",
    "command_translation.help.argument.item.replace.block.pos.slot.from.entity": "Source is an entity; its item is copied from the chosen slot.",
    "command_translation.help.argument.item.source": "The single source entity to copy from: a player name, target selector, or UUID.",
    "command_translation.help.argument.item.replace.block.pos.slot.with": "Option with: places a newly named item instead of copying from a source slot.",
    "command_translation.help.argument.item.item": "The item to place, written item_id[data_components] (components optional).",
    "command_translation.help.argument.item.count": "How many items to place: an integer from 1 to 99 inclusive; defaults to 1. Fails if it exceeds the item's stack limit.",
    "command_translation.help.argument.item.replace.entity": "Replaces into one or more entities' inventories.",
    "command_translation.help.argument.item.replace.entity.targets.slot.from": "Copies the item from a source (a block or an entity) into the target entity slot.",
    "command_translation.help.argument.item.replace.entity.targets.slot.from.block": "Source is a container block; its item is copied from the chosen slot.",
    "command_translation.help.argument.item.replace.entity.targets.slot.from.entity": "Source is an entity; its item is copied from the chosen slot.",
    "command_translation.help.argument.item.replace.entity.targets.slot.with": "Option with: places a newly named item into the target slot."
  },
  "zh_cn": {
    "command_translation.help.argument.item.modify": "把物品修饰符（loot modifier）应用到一个物品栏槽位的物品上；只有修饰符本身修改时才改变物品 id。",
    "command_translation.help.argument.item.modify.block": "目标为某方块位置的容器方块（箱子、熔炉等）。",
    "command_translation.help.argument.item.pos": "目标容器方块的位置，x y z。",
    "command_translation.help.argument.item.slot": "要修改的单个槽位，写成 slot_type 或 slot_type.number；有效槽位类型取决于目标是方块还是实体。",
    "command_translation.help.argument.item.modifier": "要应用的物品修饰符：已注册 item_modifier 的资源位置或内联 SNBT 定义；不是合法修饰符则失败。",
    "command_translation.help.argument.item.modify.entity": "目标为一个或多个实体的物品栏（玩家或生物）。",
    "command_translation.help.argument.item.targets": "要修改的一个或多个实体：玩家名、目标选择器或 UUID。",
    "command_translation.help.argument.item.replace": "用一个新物品覆盖某槽位，或从另一槽位复制物品。",
    "command_translation.help.argument.item.replace.block": "替换指定位置的容器方块中的物品。",
    "command_translation.help.argument.item.replace.block.pos.slot.from": "选项 from：从来源槽位复制物品，而不用 with 指定新物品。",
    "command_translation.help.argument.item.replace.block.pos.slot.from.block": "来源是容器方块；从所选槽位复制其物品。",
    "command_translation.help.argument.item.sourcePos": "要复制来源的容器方块位置，x y z。",
    "command_translation.help.argument.item.sourceSlot": "要复制的单个来源槽位，写成 slot_type 或 slot_type.number。",
    "command_translation.help.argument.item.replace.block.pos.slot.from.entity": "来源是实体；从所选槽位复制其物品。",
    "command_translation.help.argument.item.source": "复制的单个来源实体：玩家名、目标选择器或 UUID。",
    "command_translation.help.argument.item.replace.block.pos.slot.with": "选项 with：直接放入新指定的物品，而不是从来源槽位复制。",
    "command_translation.help.argument.item.item": "要放入的物品，写成 item_id[数据组件]（组件可省略）。",
    "command_translation.help.argument.item.count": "放入的物品数量：1 到 99 的整数（含端点），省略时为 1；超过该物品堆叠上限则失败。",
    "command_translation.help.argument.item.replace.entity": "替换一个或多个实体的物品栏。",
    "command_translation.help.argument.item.replace.entity.targets.slot.from": "从来源（方块或实体）复制物品到目标实体槽位。",
    "command_translation.help.argument.item.replace.entity.targets.slot.from.block": "来源是容器方块；从所选槽位复制其物品。",
    "command_translation.help.argument.item.replace.entity.targets.slot.from.entity": "来源是实体；从所选槽位复制其物品。",
    "command_translation.help.argument.item.replace.entity.targets.slot.with": "选项 with：把新指定的物品放入目标槽位。"
  },
