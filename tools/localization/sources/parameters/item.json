  "de_de": {
    "command_translation.help.argument.item.modify": "Wendet einen Gegenstandsmodifikator (Loot-Modifikator) auf die Gegenstände in einem Inventarplatz an; die Gegenstands-ID ändert sich nur, wenn der Modifikator dies bewirkt.",
    "command_translation.help.argument.item.modify.block": "Ziel ist ein Behältnisblock (Truhe, Ofen, ...) an einer Blockposition.",
    "command_translation.help.argument.item.pos": "Blockposition des Ziel-Behältnisblocks, als x y z.",
    "command_translation.help.argument.item.slot": "Der einzelne zu ändernde Platz, als slot_type oder slot_type.number; gültige Platztypen hängen davon ab, ob das Ziel ein Block oder eine Entität ist.",
    "command_translation.help.argument.item.modifier": "Der anzuwendende Gegenstandsmodifikator: eine Ressourcenposition eines registrierten item_modifier oder eine Inline-SNBT-Definition; schlägt bei Ungültigkeit fehl.",
    "command_translation.help.argument.item.modify.entity": "Ziel sind die Inventare einer oder mehrerer Entitäten (Spieler oder Kreaturen).",
    "command_translation.help.argument.item.targets": "Eine oder mehrere zu ändernde Entitäten: ein Spielername, Zielselektor oder eine UUID.",
    "command_translation.help.argument.item.replace": "Überschreibt die Gegenstände in einem Platz mit einem neuen Gegenstand oder kopiert sie aus einem anderen Platz.",
    "command_translation.help.argument.item.replace.block": "Ersetzt in einem Behältnisblock an der angegebenen Position.",
    "command_translation.help.argument.item.replace.block.pos.slot.from": "Option from: kopiert den Gegenstand aus einem Quellplatz, statt mit with einen neuen anzugeben.",
    "command_translation.help.argument.item.replace.block.pos.slot.from.block": "Quelle ist ein Behältnisblock; sein Gegenstand wird aus dem gewählten Platz kopiert.",
    "command_translation.help.argument.item.sourcePos": "Blockposition des Quell-Behältnisblocks, aus dem kopiert wird, als x y z.",
    "command_translation.help.argument.item.sourceSlot": "Der einzelne Quellplatz, aus dem kopiert wird, als slot_type oder slot_type.number.",
    "command_translation.help.argument.item.replace.block.pos.slot.from.entity": "Quelle ist eine Entität; ihr Gegenstand wird aus dem gewählten Platz kopiert.",
    "command_translation.help.argument.item.source": "Die einzelne Quell-Entität, aus der kopiert wird: ein Spielername, Zielselektor oder eine UUID.",
    "command_translation.help.argument.item.replace.block.pos.slot.with": "Option with: platziert einen neu angegebenen Gegenstand, statt aus einem Quellplatz zu kopieren.",
    "command_translation.help.argument.item.item": "Der zu platzierende Gegenstand, als item_id[data_components] (Komponenten optional).",
    "command_translation.help.argument.item.count": "Wie viele Gegenstände platziert werden: eine Ganzzahl von 1 bis einschließlich 99; Standard 1. Schlägt fehl, wenn das Stapellimit überschritten wird.",
    "command_translation.help.argument.item.replace.entity": "Ersetzt in den Inventaren einer oder mehrerer Entitäten.",
    "command_translation.help.argument.item.replace.entity.targets.slot.from": "Kopiert den Gegenstand aus einer Quelle (ein Block oder eine Entität) in den Zielplatz der Entität.",
    "command_translation.help.argument.item.replace.entity.targets.slot.from.block": "Quelle ist ein Behältnisblock; sein Gegenstand wird aus dem gewählten Platz kopiert.",
    "command_translation.help.argument.item.replace.entity.targets.slot.from.entity": "Quelle ist eine Entität; ihr Gegenstand wird aus dem gewählten Platz kopiert.",
    "command_translation.help.argument.item.replace.entity.targets.slot.with": "Option with: platziert einen neu angegebenen Gegenstand in den Zielplatz."
  },
  "ja_jp": {
    "command_translation.help.argument.item.modify": "1 つのインベントリスロットのアイテムにアイテムモディファイア（ルートモディファイア）を適用する。モディファイアが変更しない限りアイテム ID は変わらない。",
    "command_translation.help.argument.item.modify.block": "対象は、あるブロック位置のコンテナブロック（チェスト、かまどなど）。",
    "command_translation.help.argument.item.pos": "対象コンテナブロックのブロック位置。x y z。",
    "command_translation.help.argument.item.slot": "変更する単一のスロット。slot_type または slot_type.number で書く。有効なスロット型は対象がブロックかエンティティかで異なる。",
    "command_translation.help.argument.item.modifier": "適用するアイテムモディファイア：登録済み item_modifier の資源位置、またはインライン SNBT 定義。無効なら失敗する。",
    "command_translation.help.argument.item.modify.entity": "対象は 1 つ以上のエンティティ（プレイヤーまたはモブ）のインベントリ。",
    "command_translation.help.argument.item.targets": "変更する 1 つ以上のエンティティ：プレイヤー名、ターゲットセレクター、または UUID。",
    "command_translation.help.argument.item.replace": "スロットのアイテムを新しいアイテムで上書きするか、別のスロットからコピーする。",
    "command_translation.help.argument.item.replace.block": "指定した位置のコンテナブロックに置き換える。",
    "command_translation.help.argument.item.replace.block.pos.slot.from": "オプション from：with で新しいアイテムを指定する代わりに、ソーススロットからコピーする。",
    "command_translation.help.argument.item.replace.block.pos.slot.from.block": "ソースはコンテナブロック。選んだスロットからそのアイテムをコピーする。",
    "command_translation.help.argument.item.sourcePos": "コピー元のコンテナブロックのブロック位置。x y z。",
    "command_translation.help.argument.item.sourceSlot": "コピー元の単一スロット。slot_type または slot_type.number で書く。",
    "command_translation.help.argument.item.replace.block.pos.slot.from.entity": "ソースはエンティティ。選んだスロットからそのアイテムをコピーする。",
    "command_translation.help.argument.item.source": "コピー元の単一エンティティ：プレイヤー名、ターゲットセレクター、または UUID。",
    "command_translation.help.argument.item.replace.block.pos.slot.with": "オプション with：ソーススロットからコピーする代わりに、新しく指定したアイテムを置く。",
    "command_translation.help.argument.item.item": "置くアイテム。item_id[data_components] で書く（コンポーネントは省略可）。",
    "command_translation.help.argument.item.count": "置くアイテムの数：1 から 99 までの整数（両端を含む）。既定は 1。スタック上限を超えると失敗する。",
    "command_translation.help.argument.item.replace.entity": "1 つ以上のエンティティのインベントリに置き換える。",
    "command_translation.help.argument.item.replace.entity.targets.slot.from": "ソース（ブロックまたはエンティティ）から、対象エンティティのスロットにアイテムをコピーする。",
    "command_translation.help.argument.item.replace.entity.targets.slot.from.block": "ソースはコンテナブロック。選んだスロットからそのアイテムをコピーする。",
    "command_translation.help.argument.item.replace.entity.targets.slot.from.entity": "ソースはエンティティ。選んだスロットからそのアイテムをコピーする。",
    "command_translation.help.argument.item.replace.entity.targets.slot.with": "オプション with：新しく指定したアイテムを対象スロットに置く。"
  },
