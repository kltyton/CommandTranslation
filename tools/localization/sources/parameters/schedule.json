{
  "en_us": {
    "command_translation.help.argument.schedule.clear": "Cancels the pending run of the given function or function tag.",
    "command_translation.help.argument.schedule.function": "Schedules the given function, or every function in a function tag, to run after a delay.",
    "command_translation.help.argument.schedule.function.name": "The function or function tag to run.",
    "command_translation.help.argument.schedule.time": "The delay before the function runs, as a time value or game ticks.",
    "command_translation.help.argument.schedule.append": "Adds another schedule at a different time instead of replacing the existing one.",
    "command_translation.help.argument.schedule.replace": "Replaces the function's current schedule time; the default.",
    "command_translation.help.argument.schedule.clear.function": "The function or function tag whose pending schedule is removed."
  },
  "zh_cn": {
    "command_translation.help.argument.schedule.clear": "取消所给函数或函数标签的待运行计划，使其不再执行。",
    "command_translation.help.argument.schedule.function": "安排所给函数，或函数标签内的每个函数，在延迟后运行。",
    "command_translation.help.argument.schedule.function.name": "要运行的函数或函数标签。",
    "command_translation.help.argument.schedule.time": "函数运行前的延迟，写成时间值或游戏刻。",
    "command_translation.help.argument.schedule.append": "在不同时间另加一条计划，而不替换已有的。",
    "command_translation.help.argument.schedule.replace": "替换该函数当前的计划时间；默认选项。",
    "command_translation.help.argument.schedule.clear.function": "要移除待运行计划的函数或函数标签。"
  },
