{
  "en_us": {
    "command_translation.help.argument.particle.name": "Particle type and any settings it requires, all before the position.",
    "command_translation.help.argument.particle.pos": "The centre position where particles are created; defaults to the command execution position.",
    "command_translation.help.argument.particle.delta": "With count above 0, these control spread around pos using a normal distribution; with count 0, they give the single particle's direction, multiplied by speed.",
    "command_translation.help.argument.particle.speed": "With count 0, multiplies the delta motion; with count above 0, it is the standard deviation of the particles' extra parameters.",
    "command_translation.help.argument.particle.count": "The number of particles to create; 0 creates a single particle that moves along delta.",
    "command_translation.help.argument.particle.force": "Sends the particles to players within 512 blocks and shows them even if the Particles video setting is Minimal.",
    "command_translation.help.argument.particle.normal": "Sends the particles only to players within 32 blocks (the default); they may be hidden by the Minimal Particles setting.",
    "command_translation.help.argument.particle.viewers": "Limits which players see the particles instead of everyone in range."
  },
  "zh_cn": {
    "command_translation.help.argument.particle.name": "粒子类型及该类型所需的设置，整体写在位置坐标之前。",
    "command_translation.help.argument.particle.pos": "生成粒子的中心坐标；省略时使用命令执行位置。",
    "command_translation.help.argument.particle.delta": "count 大于 0 时控制粒子围绕 pos 的正态分布散布；count 为 0 时表示单个粒子的运动方向，再乘以 speed。",
    "command_translation.help.argument.particle.speed": "count 为 0 时乘以 delta 的运动；count 大于 0 时是粒子额外参数的标准差。",
    "command_translation.help.argument.particle.count": "生成的粒子数量；填 0 时生成 1 个沿 delta 运动的粒子。",
    "command_translation.help.argument.particle.force": "把粒子发送给 512 格内的玩家，且即使视频设置中粒子为“最少”也会显示。",
    "command_translation.help.argument.particle.normal": "只把粒子发送给 32 格内的玩家（默认），可能在“粒子=最少”时被隐藏。",
    "command_translation.help.argument.particle.viewers": "限定哪些玩家能看到粒子，而不是范围内所有人。"
  },
