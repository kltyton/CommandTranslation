{
  "en_us": {
    "command_translation.help.argument.waypoint.list": "Lists the tracked waypoints currently transmitted by entities.",
    "command_translation.help.argument.waypoint.modify": "Changes the appearance of the waypoint transmitted by an entity.",
    "command_translation.help.argument.waypoint.waypoint": "The single entity whose transmitted waypoint is modified; it must be a waypoint transmitter.",
    "command_translation.help.argument.waypoint.color": "Changes the waypoint colour to a named colour, overriding the default.",
    "command_translation.help.argument.waypoint.color.value": "A named colour such as red or blue; use hex for a hexadecimal code.",
    "command_translation.help.argument.waypoint.hex": "Uses an explicit hexadecimal colour code instead of a named colour.",
    "command_translation.help.argument.waypoint.hex.color": "A colour written as three or six hexadecimal digits such as FF0000.",
    "command_translation.help.argument.waypoint.color.reset": "Removes the custom colour so the waypoint uses the default.",
    "command_translation.help.argument.waypoint.style": "Sets or resets the waypoint's icon style.",
    "command_translation.help.argument.waypoint.style.reset": "Returns the waypoint style to the default minecraft:default.",
    "command_translation.help.argument.waypoint.style.set": "Applies the given waypoint style.",
    "command_translation.help.argument.waypoint.style.set.style": "A resource location of a waypoint style from a resource pack."
  },
  "zh_cn": {
