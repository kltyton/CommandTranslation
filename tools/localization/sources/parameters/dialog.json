{
  "en_us": {
    "command_translation.help.argument.dialog.clear": "Closes and removes any dialog currently shown on the targets' screen.",
    "command_translation.help.argument.dialog.clear.targets": "The players whose dialog is closed.",
    "command_translation.help.argument.dialog.show": "Opens a dialog screen for the targets.",
    "command_translation.help.argument.dialog.show.targets": "The players the dialog is shown to.",
    "command_translation.help.argument.dialog.show.targets.dialog": "The dialog to open: an existing dialog id or an inline SNBT dialog definition.",
    "command_translation.help.value.dialog.show.targets.dialog.minecraft:custom_options": "Opens the custom-options menu, listing the dialogs in the pause-menu tag, normally added by data packs.",
    "command_translation.help.value.dialog.show.targets.dialog.minecraft:quick_actions": "Opens the quick-actions menu, listing the dialogs in the quick-actions tag; its contents depend on that tag.",
    "command_translation.help.value.dialog.show.targets.dialog.minecraft:server_links": "Opens the server-links menu, showing links configured by the server such as a website or support page."
  },
  "zh_cn": {
