  "de_de": {
    "command_translation.help.argument.random.value": "Gibt eine Zufallszahl aus range aus und zeigt das Ergebnis nur dem ausführenden Spieler.",
    "command_translation.help.argument.random.roll": "Gibt eine Zufallszahl aus range aus und sendet das Ergebnis im Chat an alle Spieler.",
    "command_translation.help.argument.random.reset": "Entfernt eine Zufallssequenz und erstellt sie mit den angegebenen Einstellungen neu (ohne Seed mit den Welteinstellungen); die *-Form betrifft alle Sequenzen bzw. die Standardeinstellungen der Welt.",
    "command_translation.help.argument.random.range": "Der inklusive Ganzzahlbereich, aus dem gewählt wird, als min..max.",
    "command_translation.help.argument.random.sequence": "Die Zufallssequenz zum Abfragen oder Zurücksetzen; existiert sie nicht, wird sie erstellt.",
    "command_translation.help.argument.random.seed": "Der Salz-Ganzzahlwert, der beim Zurücksetzen in den Seed der Sequenz gemischt wird.",
    "command_translation.help.argument.random.includeWorldSeed": "Ob der Weltseed in den Seed der Sequenz gemischt wird; Standard true.",
    "command_translation.help.argument.random.includeSequenceId": "Ob der Hash der Sequenz-ID in ihren Seed gemischt wird; Standard true.",
    "command_translation.help.argument.random.all": "*: betrifft jede Zufallssequenz bzw. die Zufallssequenz-Einstellungen der Welt."
  },
  "ja_jp": {
    "command_translation.help.argument.random.value": "range からランダムな整数を出力し、結果を実行者だけに表示する。",
    "command_translation.help.argument.random.roll": "range からランダムな整数を出力し、結果をチャットで全プレイヤーに配信する。",
    "command_translation.help.argument.random.reset": "ランダムシーケンスを削除し、指定した設定で作り直す（シード未指定ならワールド設定）。* 形式はすべてのシーケンス／ワールドの既定設定を対象にする。",
    "command_translation.help.argument.random.range": "選ぶ範囲の両端を含む整数範囲。min..max の形。",
    "command_translation.help.argument.random.sequence": "サンプルまたはリセットするランダムシーケンス。その ID のシーケンスが無ければ作成される。",
    "command_translation.help.argument.random.seed": "リセット時にシーケンスのシードへ混ぜるソルトの整数。",
    "command_translation.help.argument.random.includeWorldSeed": "ワールドシードをシーケンスのシードに混ぜるか。既定は true。",
    "command_translation.help.argument.random.includeSequenceId": "シーケンス ID のハッシュをそのシードに混ぜるか。既定は true。",
    "command_translation.help.argument.random.all": "*：すべてのランダムシーケンス、またはワールドのランダムシーケンス設定を対象にする。"
  },
