{
  "en_us": {
    "command_translation.help.argument.random.value": "Outputs a random integer from range and shows the result only to the player who ran the command.",
    "command_translation.help.argument.random.roll": "Outputs a random integer from range and broadcasts the result to all players in chat.",
    "command_translation.help.argument.random.reset": "Removes and re-creates a random sequence with the given settings (the world's settings when no seed is given); the * form targets all sequences or the world's default settings.",
    "command_translation.help.argument.random.range": "The inclusive integer range to pick from, written min..max.",
    "command_translation.help.argument.random.sequence": "The random sequence to sample or reset; if no sequence with that id exists it is created.",
    "command_translation.help.argument.random.seed": "The salt integer mixed into the sequence's seed when resetting.",
    "command_translation.help.argument.random.includeWorldSeed": "Whether to mix the world seed into the sequence's seed; defaults to true.",
    "command_translation.help.argument.random.includeSequenceId": "Whether to mix the hash of the sequence's id into its seed; defaults to true.",
    "command_translation.help.argument.random.all": "*: applies to every random sequence, or to the world's random-sequence settings."
  },
  "zh_cn": {
    "command_translation.help.argument.random.value": "从 range 取一个随机整数，只把结果显示给执行该命令的玩家。",
    "command_translation.help.argument.random.roll": "从 range 取一个随机整数，并在聊天中广播给所有玩家。",
    "command_translation.help.argument.random.reset": "用给定设置重新创建某个随机序列（不给种子时使用世界设置）；* 形式作用于所有序列或世界默认设置。",
    "command_translation.help.argument.random.range": "取值的闭区间整数范围，写法为 min..max。",
    "command_translation.help.argument.random.sequence": "要采样或重置的随机序列；若该 id 的序列不存在，会自动创建。",
    "command_translation.help.argument.random.seed": "重置时混入序列种子的盐值整数。",
    "command_translation.help.argument.random.includeWorldSeed": "是否把世界种子混入序列种子；默认 true。",
    "command_translation.help.argument.random.includeSequenceId": "是否把序列 id 的哈希混入其种子；默认 true。",
    "command_translation.help.argument.random.all": "*：作用于所有随机序列，或世界的随机序列设置。"
  },
