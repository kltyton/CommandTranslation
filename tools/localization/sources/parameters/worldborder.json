{
  "en_us": {
    "command_translation.help.argument.worldborder.add": "Grows or shrinks the border by the given number of blocks; with a time it moves gradually.",
    "command_translation.help.argument.worldborder.set": "Sets the border's width and length to the given size; with a time it animates there.",
    "command_translation.help.argument.worldborder.get": "Prints the current size (diameter) of the world border.",
    "command_translation.help.argument.worldborder.center": "Moves the horizontal centre of the world border.",
    "command_translation.help.argument.worldborder.pos": "The new centre of the border as x and z coordinates.",
    "command_translation.help.argument.worldborder.distance": "In set the new border side length; in add the change to it, so negative shrinks.",
    "command_translation.help.argument.worldborder.time": "How long the border takes to move to the new size; if omitted, instantly.",
    "command_translation.help.argument.worldborder.damage": "Controls the damage dealt to players outside the border buffer.",
    "command_translation.help.argument.worldborder.amount": "Sets the per-block damage outside the buffer.",
    "command_translation.help.argument.worldborder.damagePerBlock": "Damage per second for each block a player is beyond the buffer; 0.2 is one tenth of a heart.",
    "command_translation.help.argument.worldborder.buffer": "Sets how far outside the border a player may stand before taking damage.",
    "command_translation.help.argument.worldborder.buffer.distance": "The buffer width in blocks; within it no damage is taken.",
    "command_translation.help.argument.worldborder.warning": "Controls the red tint a player sees near or about to be reached by the border.",
    "command_translation.help.argument.worldborder.warning.distance": "The distance from the border at which the red warning screen begins.",
    "command_translation.help.argument.worldborder.warning.time": "How far in advance to warn a player that a shrinking border will reach them."
  },
  "zh_cn": {
    "command_translation.help.argument.worldborder.add": "按给定方块数增大或缩小边界；给出时间时逐渐移动。",
    "command_translation.help.argument.worldborder.set": "把边界的宽与长设为给定大小；给出时间时动画过渡。",
    "command_translation.help.argument.worldborder.get": "输出世界边界当前的尺寸（直径）。",
    "command_translation.help.argument.worldborder.center": "移动世界边界的水平中心。",
    "command_translation.help.argument.worldborder.pos": "边界新的中心，写成 x 与 z 坐标。",
    "command_translation.help.argument.worldborder.distance": "set 中为新的边长；add 中为边长增减量，负数表示缩小。",
    "command_translation.help.argument.worldborder.time": "边界移动到新尺寸所需时间；省略则立即变化。",
    "command_translation.help.argument.worldborder.damage": "控制对缓冲带之外玩家造成的伤害。",
    "command_translation.help.argument.worldborder.amount": "设置缓冲带外每方块的伤害。",
    "command_translation.help.argument.worldborder.damagePerBlock": "玩家每超出缓冲带 1 格每秒受到的伤害；0.2 为十分之一颗心。",
    "command_translation.help.argument.worldborder.buffer": "设置玩家在受伤前可站在边界外多远。",
    "command_translation.help.argument.worldborder.buffer.distance": "缓冲带宽度（方块）；在此范围内不受伤害。",
    "command_translation.help.argument.worldborder.warning": "控制玩家靠近边界或即将被追上时看到的红色提示。",
    "command_translation.help.argument.worldborder.warning.distance": "距边界多远开始出现红色警告画面。",
    "command_translation.help.argument.worldborder.warning.time": "收缩中的边界即将到达时提前多久预警。"
  },
