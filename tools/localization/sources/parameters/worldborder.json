  "de_de": {
    "command_translation.help.argument.worldborder.add": "Vergrößert oder verkleinert die Grenze um die angegebene Blockzahl; mit Zeit allmählich.",
    "command_translation.help.argument.worldborder.set": "Setzt Breite und Länge der Grenze auf die angegebene Größe; mit Zeit animiert.",
    "command_translation.help.argument.worldborder.get": "Gibt die aktuelle Größe (Durchmesser) der Weltgrenze aus.",
    "command_translation.help.argument.worldborder.center": "Verschiebt die waagerechte Mitte der Weltgrenze.",
    "command_translation.help.argument.worldborder.pos": "Die neue Mitte der Grenze als x- und z-Koordinate.",
    "command_translation.help.argument.worldborder.distance": "Bei set die neue Seitenlänge, bei add die Änderung; negativ verkleinert.",
    "command_translation.help.argument.worldborder.time": "Wie lange die Grenze zur neuen Größe braucht; ohne Angabe sofort.",
    "command_translation.help.argument.worldborder.damage": "Steuert den Schaden für Spieler außerhalb des Grenzpuffers.",
    "command_translation.help.argument.worldborder.amount": "Setzt den Schaden pro Block außerhalb des Puffers.",
    "command_translation.help.argument.worldborder.damagePerBlock": "Schaden pro Sekunde je Block über den Puffer hinaus; 0.2 ist ein Zehntel Herz.",
    "command_translation.help.argument.worldborder.buffer": "Legt fest, wie weit außerhalb der Grenze ein Spieler stehen darf, bevor er Schaden nimmt.",
    "command_translation.help.argument.worldborder.buffer.distance": "Die Pufferbreite in Blöcken; darin kein Schaden.",
    "command_translation.help.argument.worldborder.warning": "Steuert die rote Tönung nahe der Grenze oder kurz vor deren Eintreffen.",
    "command_translation.help.argument.worldborder.warning.distance": "Die Entfernung zur Grenze, ab der der rote Warnbildschirm beginnt.",
    "command_translation.help.argument.worldborder.warning.time": "Vorlaufzeit der Warnung, bevor eine schrumpfende Grenze den Spieler erreicht."
  },
  "ja_jp": {
    "command_translation.help.argument.worldborder.add": "境界を指定ブロック数だけ広げる、または縮める。時間指定で徐々に動く。",
    "command_translation.help.argument.worldborder.set": "境界の幅と長さを指定サイズに設定する。時間指定でアニメーションする。",
    "command_translation.help.argument.worldborder.get": "ワールド境界の現在のサイズ（直径）を出力する。",
    "command_translation.help.argument.worldborder.center": "ワールド境界の水平な中心を移動する。",
    "command_translation.help.argument.worldborder.pos": "境界の新しい中心。x と z 座標で書く。",
    "command_translation.help.argument.worldborder.distance": "set では新しい一辺の長さ、add ではその増減量。負数で縮小。",
    "command_translation.help.argument.worldborder.time": "境界が新しいサイズへ移動するのにかかる時間。省略で即時。",
    "command_translation.help.argument.worldborder.damage": "境界バッファの外にいるプレイヤーへのダメージを制御する。",
    "command_translation.help.argument.worldborder.amount": "バッファ外の 1 ブロックあたりのダメージを設定する。",
    "command_translation.help.argument.worldborder.damagePerBlock": "バッファを超えた 1 ブロックごとの毎秒ダメージ。0.2 はハート 1/10。",
    "command_translation.help.argument.worldborder.buffer": "プレイヤーがダメージを受ける前に境界の外へ出られる距離を設定する。",
    "command_translation.help.argument.worldborder.buffer.distance": "バッファ幅（ブロック）。この範囲内ではダメージを受けない。",
    "command_translation.help.argument.worldborder.warning": "境界に近い、または迫っているときの赤い表示を制御する。",
    "command_translation.help.argument.worldborder.warning.distance": "赤い警告画面が出始める境界からの距離。",
    "command_translation.help.argument.worldborder.warning.time": "縮小する境界が到達する何秒前から警告するか。"
  },
