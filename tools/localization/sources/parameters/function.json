  "de_de": {
    "command_translation.help.argument.function.name": "Die auszuführende Funktion oder das Funktions-Tag: eine Ressourcenposition führt eine Funktion aus, ein #-Wert jede Funktion in diesem Tag, im Kontext des Aufrufers.",
    "command_translation.help.argument.function.name.arguments": "Inline als ein SNBT-Compound angegebene Makro-Argumente, deren Werte die $(...)-Platzhalter der Funktion ersetzen.",
    "command_translation.help.argument.function.name.with": "Führt die Funktion mit Argumenten aus, die aus einer separaten NBT-Quelle (block, entity oder storage) statt aus einem Inline-Compound gelesen werden.",
    "command_translation.help.argument.function.name.with.block": "Liest die Makro-Argumente aus dem NBT eines Block-Entities an einer Position.",
    "command_translation.help.argument.function.name.with.block.sourcePos": "Blockposition dieses Block-Entities, als x y z.",
    "command_translation.help.argument.function.name.with.block.sourcePos.path": "NBT-Pfad, der sich auf genau ein als Argumente dienendes Compound-Tag auflösen muss.",
    "command_translation.help.argument.function.name.with.entity": "Liest die Makro-Argumente aus dem NBT einer Entität.",
    "command_translation.help.argument.function.name.with.entity.source": "Die einzelne Entität, die die Argumente liefert: ein Spielername, Zielselektor oder eine UUID.",
    "command_translation.help.argument.function.name.with.entity.source.path": "NBT-Pfad, der sich auf genau ein als Argumente dienendes Compound-Tag auflösen muss.",
    "command_translation.help.argument.function.name.with.storage": "Liest die Makro-Argumente aus einem Befehls-NBT-Speicher.",
    "command_translation.help.argument.function.name.with.storage.source": "Ressourcenpositions-ID des Speichers, aus dem Argumente gelesen werden; er muss nicht registriert sein.",
    "command_translation.help.argument.function.name.with.storage.source.path": "NBT-Pfad, der sich auf genau ein als Argumente dienendes Compound-Tag auflösen muss."
  },
  "ja_jp": {
    "command_translation.help.argument.function.name": "実行する関数または関数タグ。資源位置なら 1 関数を、# で始まる値ならそのタグ内の全関数を、呼び出し元の実行コンテキストで実行する。",
    "command_translation.help.argument.function.name.arguments": "インラインで 1 つの SNBT 複合タグとして与えるマクロ引数で、その値が関数の $(...) プレースホルダーを置き換える。",
    "command_translation.help.argument.function.name.with": "インラインの複合タグの代わりに、別の NBT ソース（block、entity、storage）から読み取った引数で関数を実行する。",
    "command_translation.help.argument.function.name.with.block": "指定した位置のブロックエンティティの NBT からマクロ引数を読み取る。",
    "command_translation.help.argument.function.name.with.block.sourcePos": "そのブロックエンティティのブロック位置。x y z。",
    "command_translation.help.argument.function.name.with.block.sourcePos.path": "引数として使う複合タグに必ず 1 つだけ解決される NBT パス。",
    "command_translation.help.argument.function.name.with.entity": "エンティティの NBT からマクロ引数を読み取る。",
    "command_translation.help.argument.function.name.with.entity.source": "引数を提供する単一のエンティティ：プレイヤー名、ターゲットセレクター、または UUID。",
    "command_translation.help.argument.function.name.with.entity.source.path": "引数として使う複合タグに必ず 1 つだけ解決される NBT パス。",
    "command_translation.help.argument.function.name.with.storage": "コマンド NBT ストレージからマクロ引数を読み取る。",
    "command_translation.help.argument.function.name.with.storage.source": "引数を読み取るストレージの資源位置 ID。登録は不要。",
    "command_translation.help.argument.function.name.with.storage.source.path": "引数として使う複合タグに必ず 1 つだけ解決される NBT パス。"
  },
