{
  "en_us": {
    "command_translation.help.argument.function.name": "The function or function tag to run: a resource location runs one function, a #-prefixed value runs every function in that tag, in the caller's execution context.",
    "command_translation.help.argument.function.name.arguments": "Macro arguments given inline as one SNBT compound whose values replace the function's $(...) placeholders.",
    "command_translation.help.argument.function.name.with": "Runs the function with arguments read from a separate NBT source (block, entity, or storage) instead of an inline compound.",
    "command_translation.help.argument.function.name.with.block": "Reads the macro arguments from a block entity's NBT at a position.",
    "command_translation.help.argument.function.name.with.block.sourcePos": "Block position of that block entity, as x y z.",
    "command_translation.help.argument.function.name.with.block.sourcePos.path": "NBT path that must resolve to exactly one compound tag used as the arguments.",
    "command_translation.help.argument.function.name.with.entity": "Reads the macro arguments from an entity's NBT.",
    "command_translation.help.argument.function.name.with.entity.source": "The single entity supplying the arguments: a player name, target selector, or UUID.",
    "command_translation.help.argument.function.name.with.entity.source.path": "NBT path that must resolve to exactly one compound tag used as the arguments.",
    "command_translation.help.argument.function.name.with.storage": "Reads the macro arguments from a command NBT storage.",
    "command_translation.help.argument.function.name.with.storage.source": "Resource location id of the storage to read arguments from; it need not be registered.",
    "command_translation.help.argument.function.name.with.storage.source.path": "NBT path that must resolve to exactly one compound tag used as the arguments."
  },
  "zh_cn": {
    "command_translation.help.argument.function.name": "要运行的函数或函数标签：资源位置运行单个函数，以 # 开头则运行该标签内所有函数，并沿用调用者的执行上下文。",
    "command_translation.help.argument.function.name.arguments": "以内联的一个 SNBT 复合标签给出的宏参数，其值会替换函数中的 $(...) 占位符。",
    "command_translation.help.argument.function.name.with": "用从单独 NBT 来源（block、entity 或 storage）读取的参数运行函数，而非内联复合标签。",
    "command_translation.help.argument.function.name.with.block": "从指定位置的方块实体 NBT 读取宏参数。",
    "command_translation.help.argument.function.name.with.block.sourcePos": "该方块实体的位置，x y z。",
    "command_translation.help.argument.function.name.with.block.sourcePos.path": "必须唯一解析到一个复合标签的 NBT 路径，该标签用作参数。",
    "command_translation.help.argument.function.name.with.entity": "从某个实体的 NBT 读取宏参数。",
    "command_translation.help.argument.function.name.with.entity.source": "提供参数的单个实体：玩家名、目标选择器或 UUID。",
    "command_translation.help.argument.function.name.with.entity.source.path": "必须唯一解析到一个复合标签的 NBT 路径，该标签用作参数。",
    "command_translation.help.argument.function.name.with.storage": "从命令 NBT 存储读取宏参数。",
    "command_translation.help.argument.function.name.with.storage.source": "读取参数的存储的资源位置 id，无需注册。",
    "command_translation.help.argument.function.name.with.storage.source.path": "必须唯一解析到一个复合标签的 NBT 路径，该标签用作参数。"
  },
