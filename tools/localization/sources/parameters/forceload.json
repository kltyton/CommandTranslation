  "de_de": {
    "command_translation.help.argument.forceload.add": "Lädt die Chunks mit den angegebenen Blockspalten dauerhaft, sodass sie ohne Spieler in der Nähe geladen bleiben.",
    "command_translation.help.argument.forceload.query": "Mit Position: meldet, ob dieser Chunk dauerhaft geladen ist. Ohne Position: listet alle dauerhaft geladenen Chunks der aktuellen Dimension.",
    "command_translation.help.argument.forceload.remove": "Beendet das dauerhafte Laden von Chunks, entweder für einen Bereich oder für alle.",
    "command_translation.help.argument.forceload.from": "Die Start-Blockspalte, nur X und Z.",
    "command_translation.help.argument.forceload.to": "Die End-Blockspalte (nur X und Z); mit 'from' werden alle Chunks im Rechteck erfasst.",
    "command_translation.help.argument.forceload.pos": "Eine Blockspalte (nur X und Z), die den einzelnen zu prüfenden Chunk angibt.",
    "command_translation.help.argument.forceload.all": "Beendet das dauerhafte Laden für alle Chunks der aktuellen Dimension."
  },
  "ja_jp": {
    "command_translation.help.argument.forceload.add": "指定したブロック列を含むチャンクを常時読み込みにし、近くにプレイヤーがいなくても読み込んだままにする。",
    "command_translation.help.argument.forceload.query": "座標を指定するとそのチャンクが常時読み込みかを表示し、指定しない場合は現在のディメンションの常時読み込みチャンクを一覧表示する。",
    "command_translation.help.argument.forceload.remove": "チャンクの常時読み込みを解除する（範囲またはすべて）。",
    "command_translation.help.argument.forceload.from": "開始ブロック列（X と Z のみ）。",
    "command_translation.help.argument.forceload.to": "終了ブロック列（X と Z のみ）。'from' と合わせて矩形内の全チャンクを対象にする。",
    "command_translation.help.argument.forceload.pos": "確認する単一チャンクを示すブロック列（X と Z のみ）。",
    "command_translation.help.argument.forceload.all": "現在のディメンションの全チャンクの常時読み込みを解除する。"
  },
