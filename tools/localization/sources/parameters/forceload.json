{
  "en_us": {
    "command_translation.help.argument.forceload.add": "Force-loads the chunks containing the given block columns so they stay loaded without a player nearby.",
    "command_translation.help.argument.forceload.query": "With a position, reports whether that chunk is force-loaded; without one, lists all force-loaded chunks in the current dimension.",
    "command_translation.help.argument.forceload.remove": "Stops force-loading chunks, either a range or all of them.",
    "command_translation.help.argument.forceload.from": "The start block column, given as X and Z only.",
    "command_translation.help.argument.forceload.to": "The end block column (X and Z only); with 'from' it covers every chunk in the rectangle.",
    "command_translation.help.argument.forceload.pos": "A block column (X and Z only) identifying the single chunk to check.",
    "command_translation.help.argument.forceload.all": "Removes force-loading from every chunk in the current dimension."
  },
  "zh_cn": {
    "command_translation.help.argument.forceload.add": "强制加载包含给定方块列的区块，使其在无玩家附近时也保持加载。",
    "command_translation.help.argument.forceload.query": "给出坐标时查询该区块是否被强制加载；不给出时列出当前维度所有被强制加载的区块。",
    "command_translation.help.argument.forceload.remove": "取消强制加载，可作用于一个范围或全部区块。",
    "command_translation.help.argument.forceload.from": "起始方块列，只给 X 与 Z。",
    "command_translation.help.argument.forceload.to": "结束方块列，只给 X 与 Z；与 from 一起覆盖矩形内的所有区块。",
    "command_translation.help.argument.forceload.pos": "待查询区块所在的方块列，只给 X 与 Z。",
    "command_translation.help.argument.forceload.all": "取消当前维度中所有区块的强制加载。"
  },
