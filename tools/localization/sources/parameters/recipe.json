  "de_de": {
    "command_translation.help.argument.recipe.give": "Schaltet Rezepte für die Ziele frei (gibt sie), sodass sie im Rezeptbuch erscheinen.",
    "command_translation.help.argument.recipe.take": "Sperrt Rezepte bei den Zielen (nimmt sie), sodass sie bis zur erneuten Freischaltung nicht erscheinen.",
    "command_translation.help.argument.recipe.target": "Die Spieler, deren Rezeptbuch geändert wird.",
    "command_translation.help.argument.recipe.recipe": "Das zu gebende oder zu nehmende Rezept.",
    "command_translation.help.argument.recipe.all": "*: gilt auf einmal für alle Rezepte."
  },
  "ja_jp": {
    "command_translation.help.argument.recipe.give": "対象のレシピを解放（付与）し、レシピ帳に表示されるようにする。",
    "command_translation.help.argument.recipe.take": "対象のレシピをロック（剥奪）し、再解放されるまで表示されないようにする。",
    "command_translation.help.argument.recipe.target": "レシピ帳を変更するプレイヤー。",
    "command_translation.help.argument.recipe.recipe": "付与または剥奪するレシピ。",
    "command_translation.help.argument.recipe.all": "*：すべてのレシピを一度に対象にする。"
