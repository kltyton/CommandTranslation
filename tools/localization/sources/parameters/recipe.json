{
  "en_us": {
    "command_translation.help.argument.recipe.give": "Unlocks (gives) recipes for the targets so they appear in the recipe book.",
    "command_translation.help.argument.recipe.take": "Locks (takes) recipes from the targets so they no longer appear until unlocked again.",
    "command_translation.help.argument.recipe.target": "The players whose recipe book is changed.",
    "command_translation.help.argument.recipe.recipe": "The recipe to give or take.",
    "command_translation.help.argument.recipe.all": "*: applies to every recipe at once."
  },
  "zh_cn": {
    "command_translation.help.argument.recipe.give": "为目标解锁（给予）配方，使其出现在配方书中。",
    "command_translation.help.argument.recipe.take": "从目标身上锁定（收回）配方，使其在重新解锁前不再出现。",
    "command_translation.help.argument.recipe.target": "要更改配方书的玩家。",
    "command_translation.help.argument.recipe.recipe": "要给予或收回的配方。",
    "command_translation.help.argument.recipe.all": "*：一次作用于所有配方。"
  },
