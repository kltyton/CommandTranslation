{
  "en_us": {
    "command_translation.help.argument.place.feature": "Places a configured world-generation feature at a position.",
    "command_translation.help.argument.place.feature.feature": "The configured feature to place.",
    "command_translation.help.argument.place.pos": "The block position where placement starts.",
    "command_translation.help.argument.place.jigsaw": "Assembles structures from a jigsaw template pool, like village pieces.",
    "command_translation.help.argument.place.pool": "The template pool to start generating from.",
    "command_translation.help.argument.place.target": "The jigsaw block's target name used to connect pieces.",
    "command_translation.help.argument.place.max_depth": "How many jigsaw connection steps generation may follow; a larger value allows a more extended structure.",
    "command_translation.help.argument.place.structure": "Places a full configured structure at a position.",
    "command_translation.help.argument.place.structure.structure": "The structure to place.",
    "command_translation.help.argument.place.template": "Places a saved structure template file at a position.",
    "command_translation.help.argument.place.template.template": "The saved structure template to place; this selects a template, not a configured world-generation structure.",
    "command_translation.help.argument.place.rotation": "Rotates the template around its placement point: none, clockwise_90, counterclockwise_90 or 180.",
    "command_translation.help.argument.place.mirror": "Mirrors the placed template: none, left_right or front_back.",
    "command_translation.help.argument.place.integrity": "How complete the placed template is; below full, blocks are randomly omitted.",
    "command_translation.help.argument.place.seed": "The seed used for the random degradation when integrity is below full.",
    "command_translation.help.argument.place.strict": "Places blocks exactly as specified without triggering neighboring block updates or recalculating block shapes."
  },
  "zh_cn": {
    "command_translation.help.argument.place.feature": "在指定位置放置一个已配置的世界生成地物。",
    "command_translation.help.argument.place.feature.feature": "要放置的已配置地物。",
    "command_translation.help.argument.place.pos": "开始放置的方块坐标。",
    "command_translation.help.argument.place.jigsaw": "依据拼图模板池拼装结构，比如村庄的各部分。",
    "command_translation.help.argument.place.pool": "开始生成的模板池。",
    "command_translation.help.argument.place.target": "用于连接各拼图块的拼图方块目标名称。",
    "command_translation.help.argument.place.max_depth": "拼图生成最多沿连接展开多少层，数值越大结构可展开得越远。",
    "command_translation.help.argument.place.structure": "在指定位置放置一个完整的已配置结构。",
    "command_translation.help.argument.place.structure.structure": "要放置的结构。",
    "command_translation.help.argument.place.template": "在指定位置放置一个已保存的结构模板文件。",
    "command_translation.help.argument.place.template.template": "要放置的已保存结构模板；这里选择的是模板，而非世界生成的整结构。",
    "command_translation.help.argument.place.rotation": "围绕放置点旋转模板：不旋转、顺时针 90 度、逆时针 90 度或 180 度。",
    "command_translation.help.argument.place.mirror": "镜像所放置的模板：不镜像、左右镜像或前后镜像。",
    "command_translation.help.argument.place.integrity": "所放置模板的完整程度；低于满值时方块会随机缺失。",
    "command_translation.help.argument.place.seed": "完整度低于满值时，用于随机残缺的种子。",
    "command_translation.help.argument.place.strict": "按指定状态直接放置方块，不触发邻近方块更新，也不重新计算方块形状。"
  },
