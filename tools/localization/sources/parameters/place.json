  "de_de": {
    "command_translation.help.argument.place.feature": "Platziert ein konfiguriertes Weltgenerierungs-Feature an einer Position.",
    "command_translation.help.argument.place.feature.feature": "Das zu platzierende konfigurierte Feature.",
    "command_translation.help.argument.place.pos": "Die Blockposition, an der das Platzieren beginnt.",
    "command_translation.help.argument.place.jigsaw": "Setzt Bauwerke aus einem Jigsaw-Vorlagenpool zusammen, wie Dorfteile.",
    "command_translation.help.argument.place.pool": "Der Vorlagenpool, von dem aus die Generierung startet.",
    "command_translation.help.argument.place.target": "Der Zielname des Jigsaw-Blocks, der zum Verbinden der Teile dient.",
    "command_translation.help.argument.place.max_depth": "Wie viele Jigsaw-Verbindungsschritte die Generierung verfolgen darf; ein größerer Wert erlaubt ein ausgedehnteres Bauwerk.",
    "command_translation.help.argument.place.structure": "Platziert ein vollständiges konfiguriertes Bauwerk an einer Position.",
    "command_translation.help.argument.place.structure.structure": "Das zu platzierende Bauwerk.",
    "command_translation.help.argument.place.template": "Platziert eine gespeicherte Strukturvorlagendatei an einer Position.",
    "command_translation.help.argument.place.template.template": "Die zu platzierende gespeicherte Strukturvorlage; dies wählt eine Vorlage, kein konfiguriertes Weltgenerierungs-Bauwerk.",
    "command_translation.help.argument.place.rotation": "Dreht die Vorlage um ihren Platzierungspunkt: none, clockwise_90, counterclockwise_90 oder 180.",
    "command_translation.help.argument.place.mirror": "Spiegelt die platzierte Vorlage: none, left_right oder front_back.",
    "command_translation.help.argument.place.integrity": "Wie vollständig die platzierte Vorlage ist; unter dem vollen Wert werden Blöcke zufällig weggelassen.",
    "command_translation.help.argument.place.seed": "Der Seed für die zufällige Ausdünnung, wenn die Vollständigkeit unter dem vollen Wert liegt.",
    "command_translation.help.argument.place.strict": "Platziert Blöcke genau wie angegeben, ohne benachbarte Blockupdates auszulösen oder Blockformen neu zu berechnen."
  },
  "ja_jp": {
    "command_translation.help.argument.place.feature": "設定済みのワールド生成フィーチャーをある位置に配置する。",
    "command_translation.help.argument.place.feature.feature": "配置する設定済みフィーチャー。",
    "command_translation.help.argument.place.pos": "配置を開始するブロック位置。",
    "command_translation.help.argument.place.jigsaw": "ジグソーテンプレートプールから構造物を組み立てる。村のパーツのようなもの。",
    "command_translation.help.argument.place.pool": "生成の起点となるテンプレートプール。",
    "command_translation.help.argument.place.target": "パーツ同士をつなぐために使うジグソーブロックのターゲット名。",
    "command_translation.help.argument.place.max_depth": "生成がたどれるジグソー接続の段数。値が大きいほど構造物をより広く展開できる。",
    "command_translation.help.argument.place.structure": "完全な設定済み構造物をある位置に配置する。",
    "command_translation.help.argument.place.structure.structure": "配置する構造物。",
    "command_translation.help.argument.place.template": "保存済みの構造物テンプレートファイルをある位置に配置する。",
    "command_translation.help.argument.place.template.template": "配置する保存済み構造物テンプレート。これは設定済みのワールド生成構造物ではなく、テンプレートを選ぶ。",
    "command_translation.help.argument.place.rotation": "テンプレートを配置点を中心に回転させる: none、clockwise_90、counterclockwise_90、180。",
    "command_translation.help.argument.place.mirror": "配置するテンプレートを鏡映する: none、left_right、front_back。",
    "command_translation.help.argument.place.integrity": "配置するテンプレートの完全さ。最大未満ではブロックがランダムに省略される。",
    "command_translation.help.argument.place.seed": "完全さが最大未満のときのランダムな欠落に使うシード。",
    "command_translation.help.argument.place.strict": "指定どおりにブロックを設置し、隣接ブロックの更新やブロック形状の再計算を行わない。"
  },
