{
  "en_us": {
    "command_translation.help.argument.weather.clear": "Sets clear weather, ending rain and thunderstorms for the chosen duration.",
    "command_translation.help.argument.weather.rain": "Starts rain, or snow in cold biomes; the optional duration controls how long it lasts.",
    "command_translation.help.argument.weather.thunder": "Starts a thunderstorm, with rain or snow according to the biome.",
    "command_translation.help.argument.weather.duration": "How long the weather lasts; if omitted, a random duration is chosen."
  },
  "zh_cn": {
    "command_translation.help.argument.weather.clear": "设为晴天，在指定时长内结束降雨与雷暴。",
    "command_translation.help.argument.weather.rain": "开始下雨，寒冷群系中为下雪；可选时长决定持续多久。",
    "command_translation.help.argument.weather.thunder": "开始雷暴，随群系表现为降雨或降雪。",
    "command_translation.help.argument.weather.duration": "天气持续时长；省略时随机选取。"
  },
