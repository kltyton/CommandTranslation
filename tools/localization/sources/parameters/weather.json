  "de_de": {
    "command_translation.help.argument.weather.clear": "Setzt klares Wetter und beendet für die gewählte Dauer Regen und Gewitter.",
    "command_translation.help.argument.weather.rain": "Startet Regen, in kalten Biomen Schnee; die optionale Dauer bestimmt die Länge.",
    "command_translation.help.argument.weather.thunder": "Startet ein Gewitter, mit Regen oder Schnee je nach Biom.",
    "command_translation.help.argument.weather.duration": "Wie lange das Wetter anhält; ohne Angabe zufällig."
