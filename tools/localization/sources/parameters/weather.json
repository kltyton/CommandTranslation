  "ja_jp": {
    "command_translation.help.argument.weather.clear": "指定時間、晴れにして雨や雷雨を止める。",
    "command_translation.help.argument.weather.rain": "雨を降らせる。寒いバイオームでは雪。省略可能な持続時間で長さを指定する。",
