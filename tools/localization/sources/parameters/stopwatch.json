{
  "en_us": {
    "command_translation.help.argument.stopwatch.create": "Creates and immediately starts a stopwatch with the given id, measuring real time.",
    "command_translation.help.argument.stopwatch.remove": "Removes the stopwatch with the given id.",
    "command_translation.help.argument.stopwatch.restart": "Resets the stopwatch to zero and starts it again.",
    "command_translation.help.argument.stopwatch.query": "Reports the elapsed real time in seconds, plus an integer result scaled by scale.",
    "command_translation.help.argument.stopwatch.id": "The resource location naming the stopwatch to operate on.",
    "command_translation.help.argument.stopwatch.scale": "Multiplies the returned time, e.g. 20 turns seconds into game ticks; the chat display is unaffected."
  },
  "zh_cn": {
