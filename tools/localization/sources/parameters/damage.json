{
  "en_us": {
    "command_translation.help.argument.damage.target": "The single entity to damage; the selector must resolve to exactly one entity.",
    "command_translation.help.argument.damage.amount": "The amount of damage to apply; each point is half a heart, and the actual damage taken is still modified by armour, enchantments and effects.",
    "command_translation.help.argument.damage.damageType": "The damage type; it decides the death message and how the damage interacts with resistances.",
    "command_translation.help.argument.damage.at": "Gives a fixed world position as the damage source, for damage not dealt by an entity.",
    "command_translation.help.argument.damage.at.location": "The coordinates the damage originates from.",
    "command_translation.help.argument.damage.by": "Names the entity that directly dealt the damage.",
    "command_translation.help.argument.damage.by.entity": "The single entity that directly dealt the damage.",
    "command_translation.help.argument.damage.from": "Names the entity that ultimately caused the damage even when a projectile dealt it.",
    "command_translation.help.argument.damage.by.entity.from.cause": "The attributing entity (owner) of the damaging entity, such as a projectile's shooter."
  },
  "zh_cn": {
    "command_translation.help.argument.damage.target": "要受到伤害的单个实体；选择器必须只解析出一个实体。",
    "command_translation.help.argument.damage.amount": "要施加的伤害量；每 1 点相当于半颗心，实际伤害仍受盔甲、附魔与效果影响。",
    "command_translation.help.argument.damage.damageType": "伤害类型，决定死亡消息以及伤害与抗性的交互。",
    "command_translation.help.argument.damage.at": "为并非由实体造成的伤害指定固定世界坐标作为来源。",
    "command_translation.help.argument.damage.at.location": "伤害来源的坐标。",
    "command_translation.help.argument.damage.by": "指定直接造成伤害的实体。",
    "command_translation.help.argument.damage.by.entity": "直接造成伤害的那个实体。",
    "command_translation.help.argument.damage.from": "指定伤害的最终归因来源，即使实际由弹射物造成。",
    "command_translation.help.argument.damage.by.entity.from.cause": "造成伤害实体的归属者，例如弹射物的发射者。"
  },
