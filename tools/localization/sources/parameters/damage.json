  "de_de": {
    "command_translation.help.argument.damage.target": "Die einzelne zu schädigende Entität; der Selektor muss sich auf genau eine Entität auflösen.",
    "command_translation.help.argument.damage.amount": "Die zuzufügende Schadensmenge; ein Punkt ist ein halbes Herz, der tatsächliche Schaden wird weiterhin von Rüstung, Verzauberungen und Effekten beeinflusst.",
    "command_translation.help.argument.damage.damageType": "Der Schadenstyp; er bestimmt die Todesnachricht und das Zusammenspiel mit Resistenzen.",
    "command_translation.help.argument.damage.at": "Gibt eine feste Weltposition als Schadensquelle an, wenn kein Wesen den Schaden verursacht hat.",
    "command_translation.help.argument.damage.at.location": "Die Koordinaten, von denen der Schaden ausgeht.",
    "command_translation.help.argument.damage.by": "Nennt die Entität, die den Schaden direkt verursacht hat.",
    "command_translation.help.argument.damage.by.entity": "Die einzelne Entität, die den Schaden direkt verursacht hat.",
    "command_translation.help.argument.damage.from": "Nennt die Entität, die den Schaden letztlich verursacht hat, auch wenn ein Projektil ihn zugefügt hat.",
    "command_translation.help.argument.damage.by.entity.from.cause": "Die zuzuordnende Entität (Besitzer) der schädigenden Entität, etwa der Schütze eines Projektils."
  },
  "ja_jp": {
    "command_translation.help.argument.damage.target": "ダメージを与える単一のエンティティ。セレクターはちょうど 1 体に解決される必要がある。",
    "command_translation.help.argument.damage.amount": "与えるダメージ量。1 ポイントはハート半分で、実際に受けるダメージは防具・エンチャント・効果の影響を受ける。",
    "command_translation.help.argument.damage.damageType": "ダメージの種類。死亡メッセージや耐性との相互作用を決める。",
    "command_translation.help.argument.damage.at": "エンティティが起こしたのではないダメージに、固定のワールド座標を発生源として与える。",
    "command_translation.help.argument.damage.at.location": "ダメージの発生源となる座標。",
    "command_translation.help.argument.damage.by": "ダメージを直接与えたエンティティを指定する。",
    "command_translation.help.argument.damage.by.entity": "ダメージを直接与えた単一のエンティティ。",
    "command_translation.help.argument.damage.from": "飛び道具が与えた場合でも、ダメージの最終的な原因となったエンティティを指定する。",
    "command_translation.help.argument.damage.by.entity.from.cause": "ダメージを与えたエンティティの帰属エンティティ。例：飛び道具の発射者。"
  },
