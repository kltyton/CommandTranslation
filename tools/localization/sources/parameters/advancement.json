{
  "en_us": {
    "command_translation.help.argument.advancement.grant": "Grants the chosen advancement(s) to the targets, announced as if earned normally.",
    "command_translation.help.argument.advancement.revoke": "Removes the chosen advancement(s) from the targets; revoked criteria can be earned again.",
    "command_translation.help.argument.advancement.targets": "The players who gain or lose advancements; only players can hold them.",
    "command_translation.help.argument.advancement.everything": "Targets all loaded advancements at once.",
    "command_translation.help.argument.advancement.from": "Targets the given advancement together with all advancements descending from it.",
    "command_translation.help.argument.advancement.until": "Targets the given advancement plus all of its ancestors up to the root.",
    "command_translation.help.argument.advancement.through": "Targets the given advancement, all its ancestors up to the root, and all its descendants.",
    "command_translation.help.argument.advancement.only": "Targets only the given advancement; with a criterion, only that one criterion.",
    "command_translation.help.argument.advancement.advancement": "The advancement to grant or revoke.",
    "command_translation.help.argument.advancement.criterion": "One criterion inside the advancement; only that criterion is granted or revoked, not the whole advancement."
  },
  "zh_cn": {
    "command_translation.help.argument.advancement.grant": "把所选进度给予目标，并像正常达成一样弹出公告。",
    "command_translation.help.argument.advancement.revoke": "从目标移除所选进度，被移除的准则可以重新达成。",
    "command_translation.help.argument.advancement.targets": "要给予或移除进度的玩家；只有玩家能拥有进度。",
    "command_translation.help.argument.advancement.everything": "一次选中所有已加载的进度。",
    "command_translation.help.argument.advancement.from": "选中给定进度及其所有下游进度（子、孙……）。",
    "command_translation.help.argument.advancement.until": "选中给定进度及其全部祖先，即它本身连同到根的各级父级。",
    "command_translation.help.argument.advancement.through": "选中给定进度、它到根的全部祖先，以及它的所有后代。",
    "command_translation.help.argument.advancement.only": "只选中给定进度；若再给出准则，则只作用于该准则。",
    "command_translation.help.argument.advancement.advancement": "要给予或移除的进度。",
    "command_translation.help.argument.advancement.criterion": "进度内的某个准则；只给予或移除该准则，而不是整个进度。"
  },
