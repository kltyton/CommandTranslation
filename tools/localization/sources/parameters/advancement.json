  "de_de": {
    "command_translation.help.argument.advancement.grant": "Vergibt den gewählten Fortschritt an die Ziele und meldet ihn wie normal erhalten.",
    "command_translation.help.argument.advancement.revoke": "Entfernt den gewählten Fortschritt von den Zielen; entfernte Kriterien können erneut erreicht werden.",
    "command_translation.help.argument.advancement.targets": "Die Spieler, die Fortschritte erhalten oder verlieren; nur Spieler können sie besitzen.",
    "command_translation.help.argument.advancement.everything": "Wählt alle geladenen Fortschritte auf einmal aus.",
    "command_translation.help.argument.advancement.from": "Wählt den angegebenen Fortschritt samt aller daraus hervorgehenden Fortschritte.",
    "command_translation.help.argument.advancement.until": "Wählt den angegebenen Fortschritt samt aller seiner Vorfahren bis zur Wurzel.",
    "command_translation.help.argument.advancement.through": "Wählt den angegebenen Fortschritt, alle Vorfahren bis zur Wurzel und alle Nachfahren.",
    "command_translation.help.argument.advancement.only": "Wählt nur den angegebenen Fortschritt; mit einem Kriterium nur dieses eine.",
    "command_translation.help.argument.advancement.advancement": "Der zu vergebende oder zu entfernende Fortschritt.",
    "command_translation.help.argument.advancement.criterion": "Ein Kriterium im Fortschritt; nur dieses wird vergeben oder entfernt, nicht der ganze Fortschritt."
  },
  "ja_jp": {
    "command_translation.help.argument.advancement.grant": "選んだ進捗を対象に付与し、通常どおり達成したように通知する。",
    "command_translation.help.argument.advancement.revoke": "対象から選んだ進捗を剥奪する。剥奪された条件は再び達成できる。",
    "command_translation.help.argument.advancement.targets": "進捗を付与・剥奪するプレイヤー。進捗を持てるのはプレイヤーだけ。",
    "command_translation.help.argument.advancement.everything": "読み込み済みのすべての進捗を一度に対象にする。",
    "command_translation.help.argument.advancement.from": "指定した進捗と、そこから派生するすべての進捗を対象にする。",
    "command_translation.help.argument.advancement.until": "指定した進捗と、根までのすべての祖先を対象にする。",
    "command_translation.help.argument.advancement.through": "指定した進捗、根までのすべての祖先、およびすべての子孫を対象にする。",
    "command_translation.help.argument.advancement.only": "指定した進捗だけを対象にする。条件を付けるとその条件だけを対象にする。",
    "command_translation.help.argument.advancement.advancement": "付与または剥奪する進捗。",
    "command_translation.help.argument.advancement.criterion": "進捗内の 1 つの条件。指定するとその条件だけを付与／剥奪し、進捗全体は扱わない。"
  },
