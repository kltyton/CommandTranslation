{
  "en_us": {
    "command_translation.help.argument.playsound.sound": "The sound event defined in sounds.json; one event may pick one of several sound files at random.",
    "command_translation.help.argument.playsound.targets": "The players who should hear the sound.",
    "command_translation.help.argument.playsound.pos": "The position the sound comes from.",
    "command_translation.help.argument.playsound.volume": "Sound volume, default 1; below 1 makes it quieter, above 1 mainly extends its audible radius rather than making it louder.",
    "command_translation.help.argument.playsound.pitch": "Pitch and speed multiplier, default 1; below 0.5 is treated as 0.5, and above 1 raises the pitch and shortens the sound.",
    "command_translation.help.argument.playsound.minVolume": "Volume for targets outside the normal audible sphere; defaults to 0, meaning they hear nothing.",
    "command_translation.help.value.playsound.source.ambient": "Ambient source channel: environmental background sounds.",
    "command_translation.help.value.playsound.source.block": "Block source channel: breaking and placing sounds.",
    "command_translation.help.value.playsound.source.hostile": "Hostile source channel: hostile mob sounds.",
    "command_translation.help.value.playsound.source.master": "Master source channel (the default).",
    "command_translation.help.value.playsound.source.music": "Music source channel.",
    "command_translation.help.value.playsound.source.neutral": "Neutral source channel: passive mob sounds.",
    "command_translation.help.value.playsound.source.player": "Player source channel.",
    "command_translation.help.value.playsound.source.record": "Record source channel: jukebox playback.",
    "command_translation.help.value.playsound.source.voice": "Voice source channel.",
    "command_translation.help.value.playsound.source.weather": "Weather source channel.",
    "command_translation.help.value.playsound.source.ui": "UI source channel."
  },
  "zh_cn": {
    "command_translation.help.argument.playsound.sound": "定义在 sounds.json 中的声音事件；一个事件可能随机选取多个声音文件之一。",
    "command_translation.help.argument.playsound.targets": "要听到声音的玩家。",
    "command_translation.help.argument.playsound.pos": "声音来源的坐标。",
    "command_translation.help.argument.playsound.volume": "声音音量，默认 1；小于 1 会减小音量，大于 1 主要扩大可听半径而非提高响度。",
    "command_translation.help.argument.playsound.pitch": "音调与速度的倍率，默认 1；小于 0.5 按 0.5 处理，大于 1 会提高音调并缩短声音。",
    "command_translation.help.argument.playsound.minVolume": "处于正常可听范围之外的目标听到的音量；默认为 0，即听不到。",
    "command_translation.help.value.playsound.source.ambient": "环境声道：环境背景音。",
    "command_translation.help.value.playsound.source.block": "方块声道：破坏与放置音效。",
    "command_translation.help.value.playsound.source.hostile": "敌对声道：敌对生物音效。",
    "command_translation.help.value.playsound.source.master": "主声道（默认）。",
    "command_translation.help.value.playsound.source.music": "音乐声道。",
    "command_translation.help.value.playsound.source.neutral": "中立声道：被动生物音效。",
