{
  "en_us": {
    "command_translation.help.argument.trigger.objective": "A trigger-criterion objective enabled for the player; writing it alone adds 1 to the score.",
    "command_translation.help.argument.trigger.add": "Adds the value to the player's current score instead of replacing it.",
    "command_translation.help.argument.trigger.set": "Sets the player's score to the value, replacing the old one.",
    "command_translation.help.argument.trigger.value": "The integer to set the score to or add; after a successful use the objective becomes disabled for that player."
  },
  "zh_cn": {
    "command_translation.help.argument.trigger.objective": "已为该玩家启用的 trigger 准则目标；只写目标时给分数加 1。",
    "command_translation.help.argument.trigger.add": "把数值加到玩家当前分数上，而非覆盖。",
    "command_translation.help.argument.trigger.set": "把玩家分数设为该数值，覆盖旧值。",
    "command_translation.help.argument.trigger.value": "要设为或加到分数的整数；成功后该目标对该玩家重新变为未启用。"
  },
