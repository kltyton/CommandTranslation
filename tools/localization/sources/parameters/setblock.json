{
  "en_us": {
    "command_translation.help.argument.setblock.pos": "The block position to change.",
    "command_translation.help.argument.setblock.block": "The block to place, with optional states or NBT.",
    "command_translation.help.argument.setblock.destroy": "Destroys the old block as if mined, dropping items and playing break effects.",
    "command_translation.help.argument.setblock.keep": "Changes the block only if the position is currently air.",
    "command_translation.help.argument.setblock.replace": "Replaces the existing block without dropping items; the default.",
    "command_translation.help.argument.setblock.strict": "Places the block exactly without updating neighbours or recalculating shapes, so states that would normally change are kept."
  },
