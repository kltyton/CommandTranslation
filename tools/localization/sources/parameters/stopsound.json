{
  "en_us": {
    "command_translation.help.argument.stopsound.targets": "The players who stop hearing the sound.",
    "command_translation.help.argument.stopsound.sound": "The sound event to stop; if omitted, every sound in the chosen source stops.",
    "command_translation.help.value.stopsound.channel.all": "Stops the sound in every source at once.",
    "command_translation.help.value.stopsound.channel.master": "Stops sounds in the Master category.",
    "command_translation.help.value.stopsound.channel.ambient": "Stops ambient and environmental sounds.",
    "command_translation.help.value.stopsound.channel.block": "Stops block sounds such as breaking and placing.",
    "command_translation.help.value.stopsound.channel.hostile": "Stops hostile mob sounds.",
    "command_translation.help.value.stopsound.channel.music": "Stops background music.",
    "command_translation.help.value.stopsound.channel.neutral": "Stops neutral mob sounds.",
    "command_translation.help.value.stopsound.channel.player": "Stops player sounds.",
    "command_translation.help.value.stopsound.channel.record": "Stops jukebox and music-disc playback.",
    "command_translation.help.value.stopsound.channel.voice": "Stops the voice/speech source.",
    "command_translation.help.value.stopsound.channel.weather": "Stops weather sounds such as rain and thunder.",
    "command_translation.help.value.stopsound.channel.ui": "Stops user-interface sounds."
  },
  "zh_cn": {
    "command_translation.help.argument.stopsound.targets": "不再听到该声音的玩家。",
    "command_translation.help.argument.stopsound.sound": "要停止的声音事件；省略则停止所选来源的全部声音。",
    "command_translation.help.value.stopsound.channel.all": "一次性停止所有来源中的该声音。",
    "command_translation.help.value.stopsound.channel.master": "停止“主”分类的声音。",
    "command_translation.help.value.stopsound.channel.ambient": "停止环境与氛围音效。",
    "command_translation.help.value.stopsound.channel.block": "停止破坏、放置等方块音效。",
    "command_translation.help.value.stopsound.channel.hostile": "停止敌对生物音效。",
    "command_translation.help.value.stopsound.channel.music": "停止背景音乐。",
    "command_translation.help.value.stopsound.channel.neutral": "停止中立生物音效。",
    "command_translation.help.value.stopsound.channel.player": "停止玩家音效。",
    "command_translation.help.value.stopsound.channel.record": "停止唱片机与音乐唱片的播放。",
    "command_translation.help.value.stopsound.channel.voice": "停止语音或说话来源的声音。",
    "command_translation.help.value.stopsound.channel.weather": "停止雨声、雷声等天气音效。",
    "command_translation.help.value.stopsound.channel.ui": "停止用户界面音效。"
  },
