{
  "en_us": {
    "command_translation.help.argument.attribute.target": "The entity whose attribute is read or changed; only players, armor stands, and mobs have attributes, and the selector must resolve to one entity.",
    "command_translation.help.argument.attribute.attribute": "The attribute to read or modify.",
    "command_translation.help.argument.attribute.target.attribute.base": "Selects the attribute's base value, before any modifiers apply.",
    "command_translation.help.argument.attribute.target.attribute.base.get": "Reads the attribute base value; an optional scale multiplies the stored result.",
    "command_translation.help.argument.attribute.scale": "Multiplies the command result and truncates toward zero, without changing the attribute.",
    "command_translation.help.argument.attribute.target.attribute.base.set": "Overwrites the attribute base value with the given number.",
    "command_translation.help.argument.attribute.value": "The new base value or modifier amount.",
    "command_translation.help.argument.attribute.target.attribute.get": "Reads the attribute total value after all modifiers apply; an optional scale multiplies the stored result.",
    "command_translation.help.argument.attribute.target.attribute.modifier": "Operates on attribute modifiers: add, remove, or read a modifier value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add": "Adds a modifier with the given id and value; fails if a modifier with that id already exists on the entity.",
    "command_translation.help.argument.attribute.uuid": "The unique UUID of the attribute modifier.",
    "command_translation.help.argument.attribute.name": "The name of the attribute modifier.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.add": "Operation add: x = x + value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.multiply": "Operation multiply: x = x + x*value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.multiply_base": "Operation multiply_base: x = x + base*value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.remove": "Removes the modifier with the given id; fails if no such modifier exists.",
    "command_translation.help.argument.attribute.target.attribute.modifier.value": "Reads the value of a single modifier attached to the entity.",
    "command_translation.help.argument.attribute.target.attribute.modifier.value.get": "Reads the chosen modifier value; an optional scale multiplies the stored result.",
    "command_translation.help.argument.attribute.id": "The unique ID of the attribute modifier.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_multiplied_base": "Operation add_multiplied_base: x = x + base*value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_multiplied_total": "Operation add_multiplied_total: x = x + x*value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_value": "Operation add_value: x = x + value.",
    "command_translation.help.argument.attribute.target.attribute.base.reset": "Restores the base value to this entity type’s default."
  },
  "zh_cn": {
    "command_translation.help.argument.attribute.target": "被读取或修改属性的实体；只有玩家、盔甲架和生物具有属性，且选择器必须解析到单个实体。",
    "command_translation.help.argument.attribute.attribute": "要读取或修改的属性。",
    "command_translation.help.argument.attribute.target.attribute.base": "选择属性的基础值（未应用任何修饰符之前的值）。",
    "command_translation.help.argument.attribute.target.attribute.base.get": "读取属性基础值；可选 scale 会乘以存储的结果。",
    "command_translation.help.argument.attribute.scale": "指令返回结果的倍率，乘后向零取整，不改变属性本身。",
    "command_translation.help.argument.attribute.target.attribute.base.set": "用给定数值覆盖属性基础值。",
    "command_translation.help.argument.attribute.value": "新的属性基础值或修饰符数值。",
    "command_translation.help.argument.attribute.target.attribute.get": "读取应用全部修饰符后的属性总值；可选 scale 会乘以存储结果。",
    "command_translation.help.argument.attribute.target.attribute.modifier": "操作属性修饰符：添加、移除或读取某修饰符的数值。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add": "添加带指定 id 和数值的修饰符；若该实体上已存在同 id 的修饰符则失败。",
    "command_translation.help.argument.attribute.uuid": "属性修饰符的唯一 UUID。",
    "command_translation.help.argument.attribute.name": "属性修饰符的名称。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.add": "操作 add：x = x + value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.multiply": "操作 multiply：x = x + x×value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.multiply_base": "操作 multiply_base：x = x + base×value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.remove": "移除实体上指定 id 的修饰符；若不存在则失败。",
    "command_translation.help.argument.attribute.target.attribute.modifier.value": "读取实体上某单个修饰符的数值。",
    "command_translation.help.argument.attribute.target.attribute.modifier.value.get": "读取所选修饰符数值；可选 scale 会乘以存储结果。",
    "command_translation.help.argument.attribute.id": "属性修饰符的唯一 ID。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_multiplied_base": "操作 add_multiplied_base：x = x + base×value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_multiplied_total": "操作 add_multiplied_total：x = x + x×value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_value": "操作 add_value：x = x + value。",
    "command_translation.help.argument.attribute.target.attribute.base.reset": "将基础值恢复为该实体的默认值。"
  },
