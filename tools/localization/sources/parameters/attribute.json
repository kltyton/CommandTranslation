  "de_de": {
    "command_translation.help.argument.attribute.target": "Die Entität, deren Attribut gelesen oder geändert wird; nur Spieler, Rüstungsständer und Kreaturen haben Attribute, und der Selektor muss sich auf eine Entität auflösen.",
    "command_translation.help.argument.attribute.attribute": "Das zu lesende oder zu ändernde Attribut.",
    "command_translation.help.argument.attribute.target.attribute.base": "Wählt den Grundwert des Attributs, bevor Modifikatoren angewendet werden.",
    "command_translation.help.argument.attribute.target.attribute.base.get": "Liest den Grundwert des Attributs; ein optionaler scale multipliziert das gespeicherte Ergebnis.",
    "command_translation.help.argument.attribute.scale": "Multipliziert das Befehlsergebnis und kürzt Richtung null, ohne das Attribut zu ändern.",
    "command_translation.help.argument.attribute.target.attribute.base.set": "Überschreibt den Grundwert des Attributs mit der angegebenen Zahl.",
    "command_translation.help.argument.attribute.value": "Der neue Basiswert oder Modifikatorbetrag.",
    "command_translation.help.argument.attribute.target.attribute.get": "Liest den Gesamtwert des Attributs nach Anwendung aller Modifikatoren; ein optionaler scale multipliziert das gespeicherte Ergebnis.",
    "command_translation.help.argument.attribute.target.attribute.modifier": "Bearbeitet Attributmodifikatoren: hinzufügen, entfernen oder einen Modifikatorwert lesen.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add": "Fügt einen Modifikator mit der angegebenen ID und dem Wert hinzu; schlägt fehl, wenn auf der Entität bereits einer mit dieser ID existiert.",
    "command_translation.help.argument.attribute.uuid": "Die eindeutige UUID des Attributmodifikators.",
    "command_translation.help.argument.attribute.name": "Der Name des Attributmodifikators.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.add": "Operation add: x = x + value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.multiply": "Operation multiply: x = x + x*value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.multiply_base": "Operation multiply_base: x = x + base*value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.remove": "Entfernt den Modifikator mit der angegebenen ID; schlägt fehl, wenn keiner existiert.",
    "command_translation.help.argument.attribute.target.attribute.modifier.value": "Liest den Wert eines einzelnen an der Entität hängenden Modifikators.",
    "command_translation.help.argument.attribute.target.attribute.modifier.value.get": "Liest den gewählten Modifikatorwert; ein optionaler scale multipliziert das gespeicherte Ergebnis.",
    "command_translation.help.argument.attribute.id": "Die eindeutige ID des Attributmodifikators.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_multiplied_base": "Operation add_multiplied_base: x = x + base*value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_multiplied_total": "Operation add_multiplied_total: x = x + x*value.",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_value": "Operation add_value: x = x + value.",
    "command_translation.help.argument.attribute.target.attribute.base.reset": "Setzt den Basiswert auf den Standardwert des Entitätstyps zurück."
  },
  "ja_jp": {
    "command_translation.help.argument.attribute.target": "属性を読み取る、または変更するエンティティ。属性を持つのはプレイヤー、防具立て、モブだけで、セレクターは単一のエンティティに解決される必要がある。",
    "command_translation.help.argument.attribute.attribute": "読み取りまたは変更する属性。",
    "command_translation.help.argument.attribute.target.attribute.base": "モディファイアを適用する前の、属性の基本値を選ぶ。",
    "command_translation.help.argument.attribute.target.attribute.base.get": "属性の基本値を読み取る。任意の scale が保存される値に掛けられる。",
    "command_translation.help.argument.attribute.scale": "属性自体を変えず、コマンドの戻り値を乗算して小数部を切り捨てる倍率。",
    "command_translation.help.argument.attribute.target.attribute.base.set": "属性の基本値を指定した数値で上書きする。",
    "command_translation.help.argument.attribute.value": "新しい属性基本値または修飾子の数値。",
    "command_translation.help.argument.attribute.target.attribute.get": "すべてのモディファイアを適用した後の属性の合計値を読み取る。任意の scale が保存結果に掛けられる。",
    "command_translation.help.argument.attribute.target.attribute.modifier": "属性モディファイアを操作する：追加、削除、またはモディファイア値の読み取り。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add": "指定した ID と値のモディファイアを追加する。同じ ID のものが既にある場合は失敗する。",
    "command_translation.help.argument.attribute.uuid": "属性修飾子を識別する一意のUUID。",
    "command_translation.help.argument.attribute.name": "属性修飾子の名前。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.add": "操作 add：x = x + value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.multiply": "操作 multiply：x = x + x*value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.uuid.name.value.multiply_base": "操作 multiply_base：x = x + base*value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.remove": "指定した ID のモディファイアを削除する。無ければ失敗する。",
    "command_translation.help.argument.attribute.target.attribute.modifier.value": "エンティティに付いている単一のモディファイアの値を読み取る。",
    "command_translation.help.argument.attribute.target.attribute.modifier.value.get": "選択したモディファイア値を読み取る。任意の scale が保存結果に掛けられる。",
    "command_translation.help.argument.attribute.id": "属性修飾子を識別する一意のID。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_multiplied_base": "操作 add_multiplied_base：x = x + base*value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_multiplied_total": "操作 add_multiplied_total：x = x + x*value。",
    "command_translation.help.argument.attribute.target.attribute.modifier.add.id.value.add_value": "操作 add_value：x = x + value。",
    "command_translation.help.argument.attribute.target.attribute.base.reset": "基本値をそのエンティティの既定値に戻す。"
  },
