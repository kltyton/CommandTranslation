{
  "en_us": {
    "command_translation.help.argument.clone.begin": "One corner block position of the source region being copied from.",
    "command_translation.help.argument.clone.end": "The opposite corner block position of the source region.",
    "command_translation.help.argument.clone.destination": "The lowest x, y and z corner of the destination region; the source region keeps its size and orientation.",
    "command_translation.help.argument.clone.from": "Reads the source region from a specified dimension instead of the execution dimension.",
    "command_translation.help.argument.clone.sourceDimension": "The dimension to read the source region from.",
    "command_translation.help.argument.clone.to": "Writes the copied region into a specified dimension instead of the execution dimension.",
    "command_translation.help.argument.clone.targetDimension": "The dimension to write the copied region to.",
    "command_translation.help.argument.clone.filter": "A block predicate selecting which blocks may be copied.",
    "command_translation.help.argument.clone.filtered": "Copies only the source blocks that match the filter.",
    "command_translation.help.argument.clone.masked": "Copies only non-air source blocks; air blocks leave the destination untouched.",
    "command_translation.help.argument.clone.replace": "Copies and replaces the entire destination region (the default).",
    "command_translation.help.argument.clone.force": "Forces the copy even when the source and destination regions overlap.",
    "command_translation.help.argument.clone.move": "After copying, replaces the copied source blocks with air.",
    "command_translation.help.argument.clone.normal": "Neither forces overlap nor moves the source (the default).",
    "command_translation.help.argument.clone.strict": "Places blocks exactly as specified without triggering neighboring block updates or recalculating block shapes."
  },
  "zh_cn": {
    "command_translation.help.argument.clone.begin": "复制来源区域的一个角的方块坐标。",
    "command_translation.help.argument.clone.end": "来源区域相对的另一个角坐标。",
    "command_translation.help.argument.clone.destination": "复制结果区域 x、y、z 最小的角；来源区域的大小和朝向保持不变。",
    "command_translation.help.argument.clone.from": "改为从指定维度读取来源区域。",
    "command_translation.help.argument.clone.sourceDimension": "读取来源区域的维度。",
    "command_translation.help.argument.clone.to": "改为把复制结果写入指定维度。",
    "command_translation.help.argument.clone.targetDimension": "写入复制结果的维度。",
    "command_translation.help.argument.clone.filter": "限定哪些方块可被复制。",
    "command_translation.help.argument.clone.filtered": "只复制来源区域中匹配过滤器的方块。",
    "command_translation.help.argument.clone.masked": "只复制非空气方块，空气方块不改变目标位置。",
    "command_translation.help.argument.clone.replace": "复制并替换整个目标区域（默认）。",
    "command_translation.help.argument.clone.force": "即使来源与目标区域重叠也强制执行复制。",
    "command_translation.help.argument.clone.move": "复制完成后，把来源中被复制的方块替换为空气。",
    "command_translation.help.argument.clone.normal": "既不强制重叠也不移动来源（默认）。",
    "command_translation.help.argument.clone.strict": "按指定状态直接放置方块，不触发邻近方块更新，也不重新计算方块形状。"
  },
