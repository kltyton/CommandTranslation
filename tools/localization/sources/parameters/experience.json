{
  "en_us": {
    "command_translation.help.argument.experience.add": "Adds experience, and a negative amount removes it; experience added as points also counts into the player's score.",
    "command_translation.help.argument.experience.set": "Sets the target's experience to an exact value.",
    "command_translation.help.argument.experience.query": "Prints the single target's experience without changing it.",
    "command_translation.help.argument.experience.targets": "The players to affect; query accepts only one player.",
    "command_translation.help.argument.experience.amount": "The amount of experience, counted as points or levels depending on the next word.",
    "command_translation.help.argument.experience.levels": "Counts the amount as experience levels, keeping the level bar progress.",
    "command_translation.help.argument.experience.points": "Counts the amount as raw experience points (the default)."
  },
  "zh_cn": {
    "command_translation.help.argument.experience.add": "增加经验，负数为扣除；以点数增加的经验也会计入玩家分数。",
    "command_translation.help.argument.experience.set": "把目标的经验设为精确值。",
    "command_translation.help.argument.experience.query": "输出单个目标的经验，不做修改。",
    "command_translation.help.argument.experience.targets": "要作用的玩家；query 只接受单个玩家。",
    "command_translation.help.argument.experience.amount": "经验的数量，按后一个词以点数或等级计。",
    "command_translation.help.argument.experience.levels": "把数量按经验等级计，保持当前等级条进度。",
    "command_translation.help.argument.experience.points": "把数量按原始经验点计（默认）。"
  },
