  "de_de": {
    "command_translation.help.argument.experience.add": "Fügt Erfahrung hinzu, ein negativer Wert entfernt sie; als Punkte zugefügte Erfahrung zählt auch in den Punktestand.",
    "command_translation.help.argument.experience.set": "Setzt die Erfahrung des Ziels auf einen genauen Wert.",
    "command_translation.help.argument.experience.query": "Gibt die Erfahrung des einzelnen Ziels aus, ohne sie zu ändern.",
    "command_translation.help.argument.experience.targets": "Die zu beeinflussenden Spieler; query akzeptiert nur einen Spieler.",
    "command_translation.help.argument.experience.amount": "Die Erfahrungsmenge, je nach nächstem Wort als Punkte oder Stufen gezählt.",
    "command_translation.help.argument.experience.levels": "Zählt die Menge als Erfahrungsstufen und behält den Fortschritt der Leiste.",
    "command_translation.help.argument.experience.points": "Zählt die Menge als rohe Erfahrungspunkte (Standard)."
  },
  "ja_jp": {
    "command_translation.help.argument.experience.add": "経験値を加算し、負の値なら減算する。ポイントで加算した経験値はプレイヤーのスコアにも入る。",
    "command_translation.help.argument.experience.set": "対象の経験値を正確な値に設定する。",
    "command_translation.help.argument.experience.query": "単一の対象の経験値を表示する（変更はしない）。",
    "command_translation.help.argument.experience.targets": "作用するプレイヤー。query は 1 人のみ受け付ける。",
    "command_translation.help.argument.experience.amount": "経験値の量。次の語に応じてポイントまたはレベルとして数える。",
    "command_translation.help.argument.experience.levels": "量を経験値レベルとして数え、レベルバーの進捗は保たれる。",
    "command_translation.help.argument.experience.points": "量を生の経験値ポイントとして数える（既定）。"
  },
