{
  "en_us": {
    "command_translation.help.argument.locate.biome": "Finds the nearest occurrence of a biome and prints its coordinates to the executor's chat.",
    "command_translation.help.argument.locate.biome.biome": "The biome or #-prefixed biome tag to search for.",
    "command_translation.help.argument.locate.poi": "Finds the nearest point of interest, such as a villager job-site block, within a 256-block radius.",
    "command_translation.help.argument.locate.poi.poi": "The point-of-interest type or #-prefixed tag to search for.",
    "command_translation.help.argument.locate.structure": "Finds the nearest generated structure and prints its coordinates; it is not always the truly closest one.",
