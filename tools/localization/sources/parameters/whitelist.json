{
  "en_us": {
    "command_translation.help.argument.whitelist.add": "Adds one or more player profiles to the whitelist; they need not be online.",
    "command_translation.help.argument.whitelist.remove": "Removes one or more player profiles from the whitelist.",
    "command_translation.help.argument.whitelist.list": "Displays every player profile currently on the whitelist.",
    "command_translation.help.argument.whitelist.on": "Enables the whitelist so only whitelisted players may join; operators can always join.",
    "command_translation.help.argument.whitelist.off": "Disables the whitelist so anyone may join.",
    "command_translation.help.argument.whitelist.reload": "Reads whitelist.json from disk again, for example after editing it outside the game.",
    "command_translation.help.argument.whitelist.targets": "One or more player profiles to add or remove; in online mode the names must be real accounts."
  },
  "zh_cn": {
