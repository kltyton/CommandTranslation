{
  "en_us": {
    "command_translation.help.argument.effect.clear": "Removes status effects instead of adding them.",
    "command_translation.help.argument.effect.give": "Adds or refreshes a status effect on the targets.",
    "command_translation.help.argument.effect.targets": "The entities to apply or remove effects from; give requires targets, clear without targets uses the executing entity.",
    "command_translation.help.argument.effect.effect": "The status effect to add or remove.",
    "command_translation.help.argument.effect.infinite": "Use instead of a duration so the effect never expires.",
    "command_translation.help.argument.effect.seconds": "The effect duration; instant effects interpret the number as game ticks.",
    "command_translation.help.argument.effect.amplifier": "Extra levels above level I, where 0 is level I and 1 is level II.",
    "command_translation.help.argument.effect.hideParticles": "true hides the effect's particles; defaults to false."
  },
  "zh_cn": {
    "command_translation.help.argument.effect.clear": "移除状态效果，而不是添加。",
    "command_translation.help.argument.effect.give": "为目标添加或刷新一个状态效果。",
    "command_translation.help.argument.effect.targets": "要施加或移除效果的实体；give 必须明确填写目标，clear 省略时作用于执行者。",
    "command_translation.help.argument.effect.effect": "要施加或移除的状态效果。",
    "command_translation.help.argument.effect.infinite": "用它代替时长，使效果永不过期。",
    "command_translation.help.argument.effect.seconds": "效果的持续时长；瞬时效果把这个数按游戏刻解释。",
    "command_translation.help.argument.effect.amplifier": "在 I 级之上追加的等级，0 即 I 级，1 即 II 级。",
    "command_translation.help.argument.effect.hideParticles": "true 隐藏该效果的粒子；默认为 false。"
  },
